---
import BaseLayout from '../layouts/BaseLayout.astro';
/* EMG EXPERIENCE SYSTEM - the homepage is the product.
   The Living Home hero is now a photoreal image (public/assets/home/living-home-hero.png).
   Hotspots are absolute-positioned over real features and deep-link into Ask Rocco (/ask?topic=).
   No fabricated stats/reviews. Backend untouched. */
const services = [
  { slug: 'hvac',       label: 'Heating &amp; Cooling', hint: 'No heat, no cool, weird noises' },
  { slug: 'plumbing',   label: 'Plumbing',              hint: 'Leaks, clogs, water heaters' },
  { slug: 'electrical', label: 'Electrical',            hint: 'Breakers, outlets, panels' },
  { slug: 'roofing',    label: 'Roofing',               hint: 'Leaks, shingles, storm damage' },
];


/* Photo hotspots: x/y are % within the hero image. tier ext = shown at rest;
   int = interior/secondary, revealed on hover/proximity/focus. */
const hotspots = [
  { key: 'roof',       label: 'Roof & Attic', topic: 'Roof & Attic', icon: 'roof',  x: 46.0, y: 15.0, tier: 'ext' },
  { key: 'gutters',    label: 'Gutters',      topic: 'Gutters',      icon: 'drop',  x: 80.5, y: 33.0, tier: 'ext' },
  { key: 'electrical', label: 'Electrical',   topic: 'Electrical',   icon: 'bolt',  x: 75.0, y: 66.0, tier: 'ext' },
  { key: 'hvac',       label: 'HVAC',         topic: 'HVAC',         icon: 'fan',   x: 80.0, y: 80.0, tier: 'ext' },
  { key: 'plumbing',   label: 'Plumbing',     topic: 'Plumbing',     icon: 'pipe',  x: 49.0, y: 82.0, tier: 'ext' },
  { key: 'foundation', label: 'Foundation',   topic: 'Foundation',   icon: 'shield',x: 60.0, y: 78.0, tier: 'ext' },
  { key: 'garage',     label: 'Garage',       topic: 'Garage',       icon: 'garage',x: 26.0, y: 66.0, tier: 'int' },
  { key: 'windows',    label: 'Windows & Doors', topic: 'Windows & Doors', icon: 'window', x: 46.0, y: 38.0, tier: 'int' },
];

const ICONS = {
  roof:   '<path d="M3 11l9-7 9 7" /><path d="M6 10v9h12v-9" />',
  drop:   '<path d="M12 3s6 6.5 6 10a6 6 0 0 1-12 0c0-3.5 6-10 6-10z" />',
  bolt:   '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" />',
  fan:    '<circle cx="12" cy="12" r="2.4" /><path d="M12 9.6c1-3 .4-5.4-1.2-6 .8 1.6.4 4 1.2 6zM14.4 12c3-1 5.4-.4 6 1.2-1.6-.8-4-.4-6-1.2zM12 14.4c-1 3-.4 5.4 1.2 6-.8-1.6-.4-4-1.2-6zM9.6 12c-3 1-5.4.4-6-1.2 1.6.8 4 .4 6 1.2z" />',
  pipe:   '<path d="M4 8h8v4H4zM12 10h4a4 4 0 0 1 4 4v6" />',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" />',
  garage: '<path d="M3 10l9-5 9 5v10H3z" /><path d="M6 20v-7h12v7" />',
  window: '<rect x="4" y="4" width="16" height="16" rx="1" /><path d="M12 4v16M4 12h16" />'
};

const prompts = [
  'My AC is blowing warm air',
  'Brown stain on my ceiling',
  'My breaker keeps tripping',
  'Water pressure dropped',
];
---

<BaseLayout title="The home guide that knows what&rsquo;s wrong" description="ServicesInMyCity is the AI guide for your home. Ask Rocco what&rsquo;s wrong before anyone touches it &mdash; then connect with a trusted local pro.">
  <!-- ===================== THE OPENING (photoreal home hero) ===================== -->
  <section class="opening" aria-label="Your home, and the guide who knows it">
    <div class="opening-home">
      <div class="stage reveal" id="stage">
        <!-- Photoreal hero. Swappable asset; hotspot overlay + Rocco handoff unchanged. -->
        <img class="hero-photo" id="heroPhoto"
             src="/assets/home/living-home-hero.png" width="1536" height="1024"
             fetchpriority="high" decoding="async"
             alt="A warmly lit two-story home at dusk. Hover or focus a part of the home to learn about that system, then ask Rocco about it." />
        <div class="hero-dim" aria-hidden="true"></div>

        <div class="hotspots">
          {hotspots.map((h) => (
            <a class="hotspot" data-sys={h.key} data-tier={h.tier}
               href={`/ask?topic=${encodeURIComponent(h.topic)}`}
               style={`left:${h.x}%;top:${h.y}%`}
               aria-label={`Ask Rocco about ${h.label}`}>
              <span class="hotspot-pin" aria-hidden="true"></span>
              <span class="hotspot-chip">
                <svg class="hotspot-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[h.icon]}></svg>
                <span class="hotspot-name">{h.label}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="opening-scrim" aria-hidden="true"></div>

    <div class="opening-top">
      <p class="opening-eyebrow reveal">Your home, understood</p>
      <h1 class="opening-title reveal">Know what’s wrong<br /><span class="opening-title-accent">before anyone touches it.</span></h1>
      <p class="opening-sub reveal">Explore your home. Understand it. Make confident decisions.</p>
    </div>

    <div class="opening-base">
      <form class="askbar reveal" action="/ask" method="get" role="search">
        <span class="askbar-rocco" aria-hidden="true">
          <img src="/assets/rocco/rocco-headshot.png" alt="" width="40" height="40" />
          <span class="askbar-pulse"></span>
        </span>
        <input class="askbar-input" type="text" name="q" autocomplete="off"
          aria-label="Describe what is happening with your home"
          placeholder="" data-greeting="1" />
        <button class="askbar-go" type="submit">
          Ask Rocco
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
      <p class="opening-hint reveal">No account. No pressure. Just answers — or hover any part of your home to look closer.</p>
      <div class="opening-prompts reveal" aria-label="Examples">
        {prompts.map((p) => (
          <a class="chip" href={`/ask?q=${encodeURIComponent(p)}`}>{p}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TRUST STRIP ===================== -->
  <section class="trust-strip reveal" aria-label="How we work">
    <div class="trust-strip-row">
      <div class="trust-item"><span class="trust-h">We’re on your side</span><span class="trust-s">Always.</span></div>
      <div class="trust-item"><span class="trust-h">Advice before referral</span><span class="trust-s">Education first.</span></div>
      <div class="trust-item"><span class="trust-h">No pay-to-rank</span><span class="trust-s">Ever.</span></div>
      <div class="trust-item"><span class="trust-h">Honest about uncertainty</span><span class="trust-s">If we’re not sure, we’ll say so.</span></div>
    </div>
  </section>

  <!-- =================== CHAPTER 1 · FROM CONFUSION TO CONFIDENCE =================== -->
    <section class="chapter ch-path" aria-labelledby="path-title">
    <div class="ch-narrow reveal">
      <h2 id="path-title" class="ch-title">It goes from “something feels wrong”<br /><span class="ch-soft">to “I know what to do” — in a few minutes.</span></h2>
      <ol class="path-steps">
        <li><span class="path-n">You notice it.</span> A stain, a sound, a smell. You say it in plain words.</li>
        <li><span class="path-n">You understand it.</span> Rocco tells you what it likely is, what it tends to cost, and whether it can wait.</li>
        <li><span class="path-n">You walk in prepared.</span> The right questions, in the right order. No more guessing.</li>
        <li><span class="path-n">You decide.</span> If it can wait, he says so. If it needs a pro, he helps you find one you trust.</li>
      </ol>
    </div>
  </section>

  <!-- =================== CHAPTER 2 · WHERE IS IT HAPPENING =================== -->
    <section class="chapter ch-where" aria-labelledby="where-title">
    <div class="ch-narrow reveal">
      <p class="ch-kicker">Not sure where to start</p>
      <h2 id="where-title" class="ch-title">Start with whatever’s on your mind.</h2>
      <p class="ch-lede ch-lede-center">Every one of these opens the same calm conversation with Rocco. There’s no wrong door.</p>
      <div class="where-row">
        {services.map((sv) => (
          <a class="where-link" href={`/ask?topic=${encodeURIComponent(sv.label.replace(/&amp;/g,"&"))}`}>
            <span class="where-link-label" set:html={sv.label}></span>
            <span class="where-link-hint">{sv.hint}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =================== CHAPTER 3 · WHY YOU CAN TRUST THE ANSWER =================== -->
  <section class="chapter ch-trust" aria-labelledby="trust-title">
    <div class="ch-head reveal">
      <p class="ch-kicker">Why you can trust the answer</p>
      <h2 id="trust-title" class="ch-title">An answer that&rsquo;s on your side.</h2>
    </div>
    <div class="trust-grid">
      <article class="trust-principle reveal">
        <h3>Rocco equips, never diagnoses</h3>
        <p>He helps you understand what&rsquo;s likely happening &mdash; then a qualified pro confirms it in person. He arms you with questions, not verdicts.</p>
      </article>
      <article class="trust-principle reveal">
        <h3>Advice before referral</h3>
        <p>You get the full picture first. Connecting with a pro is something you choose when you&rsquo;re ready &mdash; never a wall you have to get past.</p>
      </article>
      <article class="trust-principle reveal">
        <h3>No pay-to-rank</h3>
        <p>No one buys a better recommendation. Rocco has nothing to sell you, so his only job is to be right.</p>
      </article>
      <article class="trust-principle reveal">
        <h3>Honest about uncertainty</h3>
        <p>When something needs eyes on it, Rocco says so plainly. &ldquo;I&rsquo;m not sure&rdquo; is an answer he&rsquo;s willing to give.</p>
      </article>
    </div>
  </section>

  <!-- =================== CHAPTER 4 · ROCCO, THE GUIDE BESIDE YOU =================== -->
  <section class="chapter ch-rocco" aria-labelledby="rocco-title">
    <div class="rocco-inner reveal">
      <div class="rocco-portrait" aria-hidden="true">
        <img src="/assets/rocco/rocco-headshot.png" alt="" width="200" height="200" />
        <span class="rocco-ring"></span>
      </div>
      <div class="rocco-copy">
        <p class="ch-kicker ch-kicker-light">The guide beside you</p>
        <h2 id="rocco-title">Rocco has seen this before.</h2>
        <p>Think of the most level-headed person you know about homes. Calm when you&rsquo;re not. Explains things without making you feel small. Tells you the truth &mdash; even when the truth is &ldquo;this can wait.&rdquo;</p>
        <p class="rocco-quiet">That&rsquo;s who Rocco is. He works for you, not the contractor. He has nothing to sell and no reason to rush you.</p>
        <a class="btn-light" href="/ask">Talk it through with Rocco</a>
      </div>
    </div>
  </section>

  <!-- =================== CHAPTER 5 · THE HVAC PILOT, HONESTLY =================== -->
  <section class="chapter ch-pilot" aria-labelledby="pilot-title">
    <div class="ch-head reveal">
      <p class="ch-kicker">Where help is live today</p>
      <h2 id="pilot-title" class="ch-title">Heating &amp; cooling, on the Jersey Shore.</h2>
      <p class="ch-lede">We&rsquo;re starting with HVAC, in our launch towns. When you want a real person, here&rsquo;s how that works.</p>
    </div>
    <div class="pilot-grid">
      <article class="pilot-fact reveal">
        <h3>One managed partner</h3>
        <p>Not a marketplace of strangers bidding for your job. A single trusted heating &amp; cooling partner we stand behind.</p>
      </article>
      <article class="pilot-fact reveal">
        <h3>Only with your say-so</h3>
        <p>Rocco never hands off your details quietly. A pro hears from you only after you ask to be connected.</p>
      </article>
      <article class="pilot-fact reveal">
        <h3>No invented rankings</h3>
        <p>No &ldquo;top-rated near you&rdquo; theater. We&rsquo;ll tell you plainly what this pilot is &mdash; and what it isn&rsquo;t yet.</p>
      </article>
    </div>
  </section>

  <!-- =================== CLOSING · RELIEF, NOT A PITCH =================== -->
  <section class="closing reveal" aria-labelledby="closing-title">
    <p class="closing-kicker">Whenever you&rsquo;re ready</p>
    <h2 id="closing-title" class="closing-title">Start with what&rsquo;s happening.</h2>
    <p class="closing-sub">No account. No pressure. Just tell Rocco what you&rsquo;re noticing, and take it one calm step at a time.</p>
    <a class="btn-primary btn-xl" href="/ask">Tell Rocco what&rsquo;s going on</a>
    <p class="closing-area">Live now across the Jersey Shore launch area &mdash; Stafford, Manahawkin, Barnegat, LBI, Toms River, Forked River, Waretown and nearby. Not in your town yet? Rocco will tell you straight.</p>
  </section>


</BaseLayout>

<style>
  /* ============ shared rhythm ============ */
  .eyebrow{font-size:.82rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--emg-orange,#E8762B);margin:0 0 .9rem}
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
  .reveal.in{opacity:1;transform:none}
  :focus-visible{outline:3px solid #F4A24B;outline-offset:3px;border-radius:6px}

  /* ===================== THE OPENING ===================== */
.opening{position:relative;isolation:isolate;min-height:clamp(720px,100vh,1120px);display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;padding:clamp(40px,7vh,96px) clamp(20px,5vw,64px) clamp(28px,5vh,56px);}
.opening-home{position:absolute;inset:0;z-index:0;}
.opening-home .stage{position:absolute;inset:0;width:100%;height:100%;margin:0;border:0;border-radius:0;max-width:none;aspect-ratio:auto;box-shadow:none;}
/* scrims guarantee text legibility over the living canvas */
.opening-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(8,14,28,.46) 0%,rgba(8,14,28,.12) 26%,rgba(8,14,28,0) 44%,rgba(247,243,236,0) 60%,rgba(247,243,236,.5) 84%,rgba(247,243,236,.9) 100%);}
.opening-top{position:relative;z-index:2;text-align:center;}
.opening-base{position:relative;z-index:2;width:100%;max-width:680px;margin:0 auto;text-align:center;align-self:end;}
.opening-eyebrow{font-size:.78rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#ffd9a8;margin:0 0 1rem;}
.opening-title{font-size:clamp(2.4rem,5.6vw,4.4rem);line-height:1.04;letter-spacing:-.02em;font-weight:700;color:#fbf7f0;margin:0;text-shadow:0 1px 30px rgba(8,14,28,.45);}
.opening-title-accent{color:var(--emg-orange,#E8762B);}
.opening-hint{font-size:.84rem;letter-spacing:.01em;color:#5b6678;margin:.95rem auto 0;}
@media (max-width:640px){.opening{min-height:clamp(580px,90vh,820px);}}

  /* ask bar with living Rocco */
  .askbar{display:flex;align-items:center;gap:.5rem;max-width:680px;margin:0 auto;background:#fff;border:1px solid rgba(22,48,76,.10);border-radius:999px;padding:.5rem .5rem .5rem .55rem;box-shadow:0 24px 60px -28px rgba(22,48,76,.45),0 2px 8px rgba(22,48,76,.06);transition:box-shadow .4s ease,transform .4s ease,border-color .4s ease}
  .askbar:focus-within{box-shadow:0 30px 70px -26px rgba(232,118,43,.5),0 0 0 4px rgba(244,162,75,.18);border-color:rgba(244,162,75,.55);transform:translateY(-2px)}
  .askbar-rocco{position:relative;flex:0 0 auto;width:40px;height:40px}
  .askbar-rocco img{width:40px;height:40px;border-radius:50%;object-fit:cover;animation:roccoFloat 5s ease-in-out infinite}
  @keyframes roccoFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
  .askbar-pulse{position:absolute;right:1px;bottom:1px;width:10px;height:10px;border-radius:50%;background:#3AA0A0;box-shadow:0 0 0 2px #fff}
  .askbar-pulse::after{content:"";position:absolute;inset:0;border-radius:50%;background:#3AA0A0;animation:livePulse 2.4s ease-out infinite}
  @keyframes livePulse{0%{transform:scale(1);opacity:.6}100%{transform:scale(2.8);opacity:0}}
  .askbar-input{flex:1;border:0;background:transparent;font-size:1.05rem;color:#16304C;padding:.5rem .4rem}
  .askbar-input:focus{outline:none}
  .askbar-input::placeholder{color:#8696A8}
  .askbar-go{flex:0 0 auto;display:inline-flex;align-items:center;gap:.4rem;border:0;cursor:pointer;background:var(--emg-orange,#E8762B);color:#fff;font-weight:700;font-size:1rem;padding:.7rem 1.2rem;border-radius:999px;transition:transform .25s cubic-bezier(.2,.7,.2,1),box-shadow .25s,background .25s}
  .askbar-go:hover{transform:translateY(-1px) scale(1.02);box-shadow:0 12px 26px -10px rgba(232,118,43,.6);background:#F4882F}
  .askbar-go svg{transition:transform .25s}
  .askbar-go:hover svg{transform:translateX(3px)}
  .opening-prompts{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;margin-top:1.6rem}
  .chip{font-size:.92rem;color:#42546A;background:rgba(255,255,255,.7);border:1px solid rgba(22,48,76,.10);padding:.5rem .95rem;border-radius:999px;text-decoration:none;transition:all .25s cubic-bezier(.2,.7,.2,1)}
  .chip:hover{color:#16304C;background:#fff;border-color:rgba(244,162,75,.6);transform:translateY(-2px);box-shadow:0 10px 22px -12px rgba(22,48,76,.35)}

  .stage{position:relative;max-width:760px;margin:0 auto;aspect-ratio:1/.84;border-radius:28px;background:linear-gradient(180deg,#2B4A6E 0%,#15314E 100%)}
  .stage{box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 40px 90px -40px rgba(0,0,0,.6);overflow:hidden}

  /* ===== PHOTOREAL LIVING HOME HERO ===== */
  .hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 46%;display:block;z-index:0;}
  .hero-dim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(10,16,30,.62) 0%,rgba(10,16,30,.34) 34%,rgba(10,16,30,0) 60%),linear-gradient(0deg,rgba(10,16,30,.34),rgba(10,16,30,0) 36%);transition:backdrop-filter .5s ease,background .5s ease;}
  .stage.is-exploring .hero-dim{background:rgba(8,12,24,.5);backdrop-filter:blur(1.5px);-webkit-backdrop-filter:blur(1.5px);}

  /* ===== HOTSPOTS as pill-chips anchored to the photo ===== */
  .hotspots{position:absolute;inset:0;z-index:3;}
  .hotspot{position:absolute;transform:translate(-50%,-50%);display:inline-flex;align-items:center;gap:.5rem;text-decoration:none;white-space:nowrap;}
  .hotspot-pin{position:relative;flex:0 0 auto;width:16px;height:16px;border-radius:50%;background:var(--emg-orange,#E8762B);box-shadow:0 0 0 4px rgba(232,118,43,.28),0 2px 8px rgba(0,0,0,.4);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s;}
  .hotspot-pin::after{content:"";position:absolute;inset:0;border-radius:50%;background:rgba(232,118,43,.5);animation:pinPulse 2.8s ease-out infinite;}
  @keyframes pinPulse{0%{box-shadow:0 0 0 0 rgba(232,118,43,.5)}70%{box-shadow:0 0 0 12px rgba(232,118,43,0)}100%{box-shadow:0 0 0 0 rgba(232,118,43,0)}}
  .hotspot-chip{display:inline-flex;align-items:center;gap:.42rem;padding:.34rem .66rem .34rem .5rem;border-radius:999px;background:rgba(14,20,34,.82);color:#fff;font-size:.84rem;font-weight:600;line-height:1;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.14);box-shadow:0 8px 22px -10px rgba(0,0,0,.6);opacity:0;transform:translateX(-6px);transition:opacity .3s ease,transform .3s ease;}
  .hotspot-ico{width:15px;height:15px;color:var(--emg-orange,#F4A24B);flex:0 0 auto;}
  .hotspot-name{white-space:nowrap;}
  .hotspot[data-tier="ext"] .hotspot-chip{opacity:1;transform:translateX(0);}
  .hotspot:hover .hotspot-pin,.hotspot:focus-visible .hotspot-pin{transform:scale(1.3);box-shadow:0 0 0 6px rgba(232,118,43,.34),0 4px 14px rgba(0,0,0,.5);}
  .hotspot:hover .hotspot-chip,.hotspot:focus-visible .hotspot-chip{opacity:1;transform:translateX(0);background:rgba(14,20,34,.94);border-color:rgba(244,162,75,.6);}
  .hotspot[data-tier="int"]{opacity:0;pointer-events:none;transition:opacity .45s cubic-bezier(.2,.7,.2,1);}
  .stage.near .hotspot[data-tier="int"],.stage.is-exploring .hotspot[data-tier="int"],.hotspot[data-tier="int"]:focus-within{opacity:1;pointer-events:auto;}

  .opening-sub{margin:.9rem auto 0;max-width:30rem;font-size:clamp(1rem,1.4vw,1.18rem);line-height:1.5;color:rgba(255,255,255,.92);text-shadow:0 1px 14px rgba(0,0,0,.5);}

  /* ===== TRUST STRIP ===== */
  .trust-strip{background:#0E1422;color:#fff;padding:1.1rem clamp(1rem,5vw,3rem);}
  .trust-strip-row{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem 1.5rem;}
  .trust-item{display:flex;flex-direction:column;gap:.18rem;padding-left:.9rem;border-left:2px solid rgba(244,162,75,.55);}
  .trust-h{font-size:.95rem;font-weight:700;}
  .trust-s{font-size:.86rem;color:rgba(255,255,255,.62);}

  /* ===== HERO RESPONSIVE / MOBILE ===== */
  @media (max-width:760px){
    .opening{min-height:auto;}
    .hero-photo{object-position:center 42%;}
    .hero-dim{background:linear-gradient(0deg,rgba(8,12,22,.94) 0%,rgba(8,12,22,.62) 30%,rgba(8,12,22,.18) 56%,rgba(8,12,22,.42) 100%);}
    .opening-top{padding-top:clamp(2rem,9vh,4rem);}
    .hotspot[data-sys="gutters"],.hotspot[data-sys="foundation"],.hotspot[data-tier="int"]{display:none;}
    .hotspot-chip{font-size:.78rem;padding:.28rem .55rem .28rem .42rem;}
    .trust-strip-row{grid-template-columns:repeat(2,1fr);gap:.9rem 1.1rem;}
  }
  @media (max-width:440px){ .trust-strip-row{grid-template-columns:1fr;} }
  @media (prefers-reduced-motion: reduce){
    .hotspot-pin::after{animation:none;}
    .hero-dim,.hotspot,.hotspot-pin,.hotspot-chip{transition:none;}
  }

  /* ============ BUTTONS ============ */
  .btn-primary{display:inline-flex;align-items:center;gap:.5rem;background:var(--emg-orange,#E8762B);color:#fff;font-weight:700;text-decoration:none;border-radius:999px;padding:1rem 2rem;transition:transform .25s cubic-bezier(.2,.7,.2,1),box-shadow .25s,background .25s}
