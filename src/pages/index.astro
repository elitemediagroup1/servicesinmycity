---
import BaseLayout from '../layouts/BaseLayout.astro';
/* EMG EXPERIENCE SYSTEM - the homepage IS the product.
   Photoreal hero (public/assets/home/living-home-hero.png) + full-length Rocco standing in scene.
   Beacons are anchored only to features VISIBLE in the photo. Interior systems live behind X-Ray.
   Clicking a beacon does NOT navigate: it focuses the house, opens an in-page diagnostic panel,
   collects one symptom, THEN hands off to /ask with full context. Backend untouched. */

const services = [
  { slug: 'hvac',       label: 'Heating & Cooling', hint: 'No heat, no cool, weird noises' },
  { slug: 'plumbing',   label: 'Plumbing',          hint: 'Leaks, clogs, water heaters' },
  { slug: 'electrical', label: 'Electrical',        hint: 'Breakers, outlets, panels' },
  { slug: 'roofing',    label: 'Roofing',           hint: 'Leaks, shingles, storm damage' },
];

/* Each system: beacon coords are % within the framed photo.
   tier 'visible' = anchored to something you can SEE (shown at rest).
   tier 'xray'    = interior system, only shown in Look Inside mode (approx placement).
   blurb + concerns + symptoms power the in-page diagnostic panel before handoff. */
const systems = [
  { key:'roof', label:'Roof & Attic', topic:'Roof & Attic', x:44, y:15, tier:'visible',
    blurb:'Your roof protects everything underneath it.',
    concerns:['Missing shingles','Water stains','Ice dams','Poor attic ventilation'],
    symptoms:['Water stain','Missing shingles','Roof leak','Other'] },
  { key:'gutters', label:'Gutters', topic:'Gutters', x:80, y:28, tier:'visible',
    blurb:'Gutters carry water away from your roof, siding, and foundation.',
    concerns:['Overflowing','Sagging','Clogged','Loose from house'],
    symptoms:['Overflowing','Sagging or pulling away','Water near foundation','Other'] },
  { key:'window', label:'Upstairs Window', topic:'Windows', x:45, y:30, tier:'visible',
    blurb:'Windows affect comfort, drafts, and your energy bills.',
    concerns:['Drafts','Foggy glass','Hard to open','Leaks'],
    symptoms:['Drafty','Foggy between panes','Hard to open','Other'] },
  { key:'door', label:'Front Door', topic:'Doors', x:53, y:62, tier:'visible',
    blurb:'Entry doors matter for security, drafts, and weather sealing.',
    concerns:['Drafts','Sticking','Weatherstrip worn','Lock issues'],
    symptoms:['Drafty','Sticks or wont latch','Worn weatherstrip','Other'] },
  { key:'porch', label:'Porch', topic:'Porch & Exterior', x:62, y:70, tier:'visible',
    blurb:'Porches, columns, and steps take the brunt of the weather.',
    concerns:['Rotting wood','Loose railing','Cracked steps','Peeling paint'],
    symptoms:['Soft or rotting wood','Loose railing','Cracked steps','Other'] },
  { key:'electrical', label:'Electrical Meter', topic:'Electrical', x:72, y:64, tier:'visible',
    blurb:'Your meter and panel feed power to the whole home.',
    concerns:['Breaker tripping','Flickering lights','Warm outlets','Buzzing'],
    symptoms:['Breaker keeps tripping','Flickering lights','Warm or buzzing outlet','Other'] },
  { key:'hvac', label:'Air Conditioner', topic:'HVAC', x:76, y:80, tier:'visible',
    blurb:'Your outdoor unit is half of your heating and cooling system.',
    concerns:['No cool air','Strange noise','Not turning on','High bills'],
    symptoms:['Blowing warm air','Loud or strange noise','Wont turn on','Other'] },
  { key:'plumbing', label:'Plumbing', topic:'Plumbing', x:38, y:55, tier:'xray',
    blurb:'Supply and drain lines run hidden through walls and floors.',
    concerns:['Low pressure','Leaks','Slow drains','No hot water'],
    symptoms:['Low water pressure','A leak','Slow or clogged drain','Other'] },
  { key:'ducts', label:'HVAC Ducts', topic:'HVAC', x:55, y:45, tier:'xray',
    blurb:'Ductwork carries conditioned air to every room.',
    concerns:['Uneven rooms','Weak airflow','Dusty air','Whistling'],
    symptoms:['Some rooms wont heat or cool','Weak airflow','Dusty air','Other'] },
  { key:'waterheater', label:'Water Heater', topic:'Plumbing', x:40, y:70, tier:'xray',
    blurb:'Your water heater keeps hot water flowing on demand.',
    concerns:['No hot water','Runs out fast','Leaking','Rumbling'],
    symptoms:['No hot water','Runs out quickly','Leaking at the base','Other'] },
  { key:'foundation', label:'Foundation', topic:'Foundation', x:50, y:90, tier:'xray',
    blurb:'The foundation is the ground everything else rests on.',
    concerns:['Cracks','Moisture','Settling','Sticking doors'],
    symptoms:['Cracks in walls or floor','Moisture or water','Doors sticking','Other'] },
];

const prompts = [
  'My AC is blowing warm air',
  'Brown stain on my ceiling',
  'My breaker keeps tripping',
  'Water pressure dropped',
];
---

<BaseLayout title="The home guide that knows what&rsquo;s wrong" description="ServicesInMyCity is the AI guide for your home. Ask Rocco what&rsquo;s wrong before anyone touches it &mdash; then connect with a trusted local pro.">

  <!-- ===================== THE OPENING (interactive photoreal home) ===================== -->
  <section class="opening" aria-label="Your home, and the guide who knows it">
    <div class="hero-grid">
      <div class="hero-left">
        <p class="opening-eyebrow reveal">Your home, understood</p>
        <h1 class="opening-title reveal"><span class="opening-title-line">Know what’s wrong</span><span class="opening-title-accent">before anyone touches it.</span></h1>
        <p class="opening-sub reveal">Explore your home. Understand it. Make confident decisions.</p>

        <div class="rocco-card reveal">
          <div class="rocco-card-head">
            <span class="rocco-card-name">Ask Rocco</span>
            <span class="rocco-card-line">Tell Rocco what you’re noticing.</span>
          </div>
          <form class="askbar" action="/ask" method="get" role="search">
            <input class="askbar-input" type="text" name="q" autocomplete="off" aria-label="Describe what is happening with your home" placeholder="" data-greeting="1" />
            <button class="askbar-go" type="submit">Ask Rocco<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </form>
          <div class="opening-prompts" aria-label="Examples">
            {prompts.map((p) => (
              <a class="chip" href={`/ask?q=${encodeURIComponent(p)}`}>{p}</a>
            ))}
          </div>
          <p class="opening-hint">No account. No pressure. Just answers.</p>
        </div>

        <ul class="trust-points reveal" aria-label="How we work">
          <li><span class="trust-h">We’re on your side</span><span class="trust-s">Always.</span></li>
          <li><span class="trust-h">Advice before referral</span><span class="trust-s">Education first.</span></li>
          <li><span class="trust-h">No pay-to-rank</span><span class="trust-s">Ever.</span></li>
          <li><span class="trust-h">Honest about uncertainty</span><span class="trust-s">If we’re not sure, we’ll say so.</span></li>
        </ul>
      </div>

            <div class="hero-mid" aria-hidden="true">
        <img class="rocco-figure reveal" id="roccoFigure" src="/assets/rocco/rocco-full.png" alt="" width="1024" height="1536" decoding="async" />
      </div>
<div class="hero-right">
        <figure class="photo-frame" id="stage">
          <img class="hero-photo" id="heroPhoto" src="/assets/home/living-home-hero.png" width="1536" height="1024" fetchpriority="high" decoding="async" alt="A warmly lit two-story home at dusk. Select a part of the home to explore that system and tell Rocco what you are noticing." />
          <div class="stage-scrim" aria-hidden="true"></div>

          <!-- beacons: discovery points, not links. They open an in-page diagnostic. -->
          <div class="beacons">
            {systems.map((s) => (
              <button class="beacon" type="button" data-sys={s.key} data-tier={s.tier}
                style={`left:${s.x}%;top:${s.y}%`}
                aria-label={`Explore ${s.label}`}>
                <span class="beacon-glow" aria-hidden="true"></span>
                <span class="beacon-ring" aria-hidden="true"></span>
                <span class="beacon-chip">{s.label}</span>
              </button>
            ))}
          </div>

          <!-- look inside toggle -->
          <button class="xray-toggle" id="xrayToggle" type="button" aria-pressed="false">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/></svg>
            <span class="xray-label">Look inside</span>
          </button>

          <!-- in-page diagnostic panel (slides up over the stage) -->
          <button class="diag-backdrop" id="diagBackdrop" type="button" aria-label="Close panel" hidden></button>
          <div class="diag" id="diag" role="dialog" aria-modal="false" aria-labelledby="diagTitle" hidden>
            <button class="diag-close" id="diagClose" type="button" aria-label="Close">×</button>
            <p class="diag-eyebrow" id="diagEyebrow"></p>
            <h3 class="diag-title" id="diagTitle"></h3>
            <p class="diag-blurb" id="diagBlurb"></p>
            <p class="diag-concerns-label">Common homeowner concerns:</p>
            <ul class="diag-concerns" id="diagConcerns"></ul>
            <p class="diag-q">What are you noticing?</p>
            <div class="diag-options" id="diagOptions" role="radiogroup" aria-label="What are you noticing"></div>
            <a class="diag-go" id="diagGo" href="/ask">Continue with Rocco
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </figure>

      </div>
    </div>
  </section>

  <!-- =================== CHAPTER 1 · FROM CONFUSION TO CONFIDENCE =================== -->
    <section class="chapter ch-path" aria-labelledby="path-title">
    <div class="ch-narrow reveal">
      <h2 id="path-title" class="ch-title">It goes from “something feels wrong”<br /><span class="ch-soft">to “I know what to do” — in a few minutes.</span></h2>
      <ol class="path-steps">
        <li><span class="path-n">You notice it.</span> A stain, a sound, a smell. You say it in plain words.</li>
        <li><span class="path-n">You understand it.</span> Rocco tells you what it likely is, what it tends to cost, and whether it can wait.</li>
        <li><span class="path-n">You walk in prepared.</span> The right questions, in the right order. No more guessing.</li>
        <li><span class="path-n">You decide.</span> If it can wait, he says so. If it needs a pro, he helps you find one you trust.</li>
      </ol>
    </div>
  </section>

  <!-- =================== CHAPTER 2 · WHERE IS IT HAPPENING =================== -->
    <section class="chapter ch-where" aria-labelledby="where-title">
    <div class="ch-narrow reveal">
      <p class="ch-kicker">Not sure where to start</p>
      <h2 id="where-title" class="ch-title">Start with whatever’s on your mind.</h2>
      <p class="ch-lede ch-lede-center">Every one of these opens the same calm conversation with Rocco. There’s no wrong door.</p>
      <div class="where-row">
        {services.map((sv) => (
          <a class="where-link" href={`/ask?topic=${encodeURIComponent(sv.label.replace(/&amp;/g,"&"))}`}>
            <span class="where-link-label" set:html={sv.label}></span>
            <span class="where-link-hint">{sv.hint}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =================== CHAPTER 3 · WHY YOU CAN TRUST THE ANSWER =================== -->
  <section class="chapter ch-trust" aria-labelledby="trust-title">
    <div class="ch-head reveal">
      <p class="ch-kicker">Why you can trust the answer</p>
      <h2 id="trust-title" class="ch-title">An answer that&rsquo;s on your side.</h2>
    </div>
    <div class="trust-grid">
      <article class="trust-principle reveal">
        <h3>Rocco equips, never diagnoses</h3>
        <p>He helps you understand what&rsquo;s likely happening &mdash; then a qualified pro confirms it in person. He arms you with questions, not verdicts.</p>
      </article>
      <article class="trust-principle reveal">
        <h3>Advice before referral</h3>
        <p>You get the full picture first. Connecting with a pro is something you choose when you&rsquo;re ready &mdash; never a wall you have to get past.</p>
      </article>
      <article class="trust-principle reveal">
        <h3>No pay-to-rank</h3>
        <p>No one buys a better recommendation. Rocco has nothing to sell you, so his only job is to be right.</p>
      </article>
      <article class="trust-principle reveal">
        <h3>Honest about uncertainty</h3>
        <p>When something needs eyes on it, Rocco says so plainly. &ldquo;I&rsquo;m not sure&rdquo; is an answer he&rsquo;s willing to give.</p>
      </article>
    </div>
  </section>

  <!-- =================== CHAPTER 4 · ROCCO, THE GUIDE BESIDE YOU =================== -->
  <section class="chapter ch-rocco" aria-labelledby="rocco-title">
    <div class="rocco-inner reveal">
      <div class="rocco-portrait" aria-hidden="true">
        <img src="/assets/rocco/rocco-headshot.png" alt="" width="200" height="200" />
        <span class="rocco-ring"></span>
      </div>
      <div class="rocco-copy">
        <p class="ch-kicker ch-kicker-light">The guide beside you</p>
        <h2 id="rocco-title">Rocco has seen this before.</h2>
        <p>Think of the most level-headed person you know about homes. Calm when you&rsquo;re not. Explains things without making you feel small. Tells you the truth &mdash; even when the truth is &ldquo;this can wait.&rdquo;</p>
        <p class="rocco-quiet">That&rsquo;s who Rocco is. He works for you, not the contractor. He has nothing to sell and no reason to rush you.</p>
        <a class="btn-light" href="/ask">Talk it through with Rocco</a>
      </div>
    </div>
  </section>

  <!-- =================== CHAPTER 5 · THE HVAC PILOT, HONESTLY =================== -->
  <section class="chapter ch-pilot" aria-labelledby="pilot-title">
    <div class="ch-head reveal">
      <p class="ch-kicker">Where help is live today</p>
      <h2 id="pilot-title" class="ch-title">Heating &amp; cooling, on the Jersey Shore.</h2>
      <p class="ch-lede">We&rsquo;re starting with HVAC, in our launch towns. When you want a real person, here&rsquo;s how that works.</p>
    </div>
    <div class="pilot-grid">
      <article class="pilot-fact reveal">
        <h3>One managed partner</h3>
        <p>Not a marketplace of strangers bidding for your job. A single trusted heating &amp; cooling partner we stand behind.</p>
      </article>
      <article class="pilot-fact reveal">
        <h3>Only with your say-so</h3>
        <p>Rocco never hands off your details quietly. A pro hears from you only after you ask to be connected.</p>
      </article>
      <article class="pilot-fact reveal">
        <h3>No invented rankings</h3>
        <p>No &ldquo;top-rated near you&rdquo; theater. We&rsquo;ll tell you plainly what this pilot is &mdash; and what it isn&rsquo;t yet.</p>
      </article>
    </div>
  </section>

  <!-- =================== CLOSING · RELIEF, NOT A PITCH =================== -->
  <section class="closing reveal" aria-labelledby="closing-title">
    <p class="closing-kicker">Whenever you&rsquo;re ready</p>
    <h2 id="closing-title" class="closing-title">Start with what&rsquo;s happening.</h2>
    <p class="closing-sub">No account. No pressure. Just tell Rocco what you&rsquo;re noticing, and take it one calm step at a time.</p>
    <a class="btn-primary btn-xl" href="/ask">Tell Rocco what&rsquo;s going on</a>
    <p class="closing-area">Live now across the Jersey Shore launch area &mdash; Stafford, Manahawkin, Barnegat, LBI, Toms River, Forked River, Waretown and nearby. Not in your town yet? Rocco will tell you straight.</p>
  </section>

</BaseLayout>

<style>
  /* ============ shared rhythm ============ */
  .eyebrow{font-size:.82rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--emg-orange,#E8762B);margin:0 0 .9rem}
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
  .reveal.in{opacity:1;transform:none}
  :focus-visible{outline:3px solid #F4A24B;outline-offset:3px;border-radius:6px}

  /* ===== HERO: interactive editorial composition ===== */
  .opening{position:relative;isolation:isolate;background:radial-gradient(120% 120% at 78% 0%,#152339 0%,#0c1424 50%,#070d18 100%);color:#fff;min-height:92vh;display:flex;align-items:center;padding:clamp(64px,8vh,96px) clamp(24px,4vw,72px) clamp(36px,5vh,60px);overflow:hidden;}
  .opening::before{content:"";position:absolute;inset:0;z-index:0;background:radial-gradient(70% 90% at 70% 42%,rgba(232,118,43,.13),transparent 72%);pointer-events:none;}
  .hero-grid{position:relative;z-index:1;width:100%;max-width:1640px;margin:0 auto;display:grid;grid-template-columns:minmax(0,0.78fr) minmax(0,0.42fr) minmax(0,1.06fr);gap:clamp(8px,1vw,24px);align-items:end;}
  /* ---- LEFT: content ---- */
  .hero-left{display:flex;flex-direction:column;gap:clamp(13px,1.7vh,19px);max-width:600px;justify-self:end;align-self:center;}
  .opening-eyebrow{margin:0;font-size:.8rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#E8762B;}
  .opening-title{margin:0;font-weight:800;line-height:1.04;letter-spacing:-.02em;font-size:clamp(2.4rem,4.4vw,3.85rem);display:flex;flex-direction:column;}
  .opening-title-line{color:#fff;}
  .opening-title-accent{color:#E8762B;}
  .opening-sub{margin:0;font-size:clamp(1.02rem,1.4vw,1.22rem);line-height:1.5;color:rgba(255,255,255,.78);max-width:42ch;}
  /* ---- Ask Rocco card (no headshot inside now) ---- */
  .rocco-card{margin-top:4px;background:rgba(16,24,40,.72);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:clamp(18px,2.2vw,26px);box-shadow:0 24px 60px -24px rgba(0,0,0,.7);display:flex;flex-direction:column;gap:14px;}
  .rocco-card-head{display:flex;flex-direction:column;gap:3px;}
  .rocco-card-name{font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#E8762B;}
  .rocco-card-line{font-size:1.12rem;font-weight:600;color:#fff;line-height:1.25;}
  .askbar{display:flex;gap:10px;align-items:stretch;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:6px;}
  .askbar-input{flex:1;min-width:0;border:0;background:transparent;color:#fff;font-size:1.02rem;padding:12px 14px;outline:none;}
  .askbar-input::placeholder{color:rgba(255,255,255,.5);}
  .askbar-go{flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;border:0;cursor:pointer;background:#E8762B;color:#fff;font-weight:700;font-size:1rem;padding:12px 20px;border-radius:11px;box-shadow:0 8px 22px -6px rgba(232,118,43,.6);transition:transform .2s,box-shadow .2s,filter .2s;}
  .askbar-go:hover{filter:brightness(1.06);transform:translateY(-1px);box-shadow:0 12px 28px -6px rgba(232,118,43,.7);}
  .opening-prompts{display:flex;flex-wrap:wrap;gap:8px;}
  .chip{display:inline-flex;align-items:center;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.82);font-size:.9rem;text-decoration:none;transition:background .2s,border-color .2s,color .2s;}
  .chip:hover{background:rgba(232,118,43,.16);border-color:rgba(232,118,43,.5);color:#fff;}
  .opening-hint{margin:0;font-size:.85rem;color:rgba(255,255,255,.55);}
  .trust-points{list-style:none;margin:6px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:13px 22px;}
  .trust-points li{display:flex;flex-direction:column;gap:1px;border-left:2px solid rgba(232,118,43,.55);padding-left:12px;}
  .trust-h{font-size:.92rem;font-weight:700;color:#fff;}
  .trust-s{font-size:.82rem;color:rgba(255,255,255,.6);}

  /* ---- RIGHT: framed photo + full-length Rocco ---- */
  .hero-right{position:relative;}
  .photo-frame{position:relative;margin:0;border-radius:28px;overflow:hidden;box-shadow:0 50px 110px -34px rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.09);background:#0a1120;aspect-ratio:7 / 5;height:min(76vh,680px);width:100%;}
  .hero-photo{display:block;width:100%;height:100%;object-fit:cover;object-position:center 46%;transition:filter .6s ease,transform .6s ease;}
  .stage-scrim{position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(closest-side at var(--fx,50%) var(--fy,50%),transparent 0,transparent 16%,rgba(6,11,20,.62) 60%,rgba(6,11,20,.82) 100%);transition:opacity .55s ease;z-index:2;}
  /* when a system is focused, dim the rest of the house and spotlight the area */
  .photo-frame.is-focused .hero-photo{filter:brightness(.7) saturate(.9);}
  .photo-frame.is-focused .stage-scrim{opacity:1;}
  /* full-length Rocco: stands at the lower-left of the scene, overlapping frame edge */
  .hero-mid{position:relative;align-self:end;display:flex;justify-content:center;align-items:flex-end;pointer-events:none;z-index:4;}
  .rocco-figure{display:block;width:auto;max-width:none;height:min(74vh,620px);margin-right:clamp(-72px,-4vw,-30px);margin-bottom:-2px;pointer-events:none;filter:drop-shadow(0 26px 34px rgba(0,0,0,.55));transition:transform .5s cubic-bezier(.2,.7,.2,1),opacity .5s;}
  

  /* ---- beacons (discovery points, not pins) ---- */
  .beacons{position:absolute;inset:0;z-index:52;}
  .beacon{position:absolute;transform:translate(-50%,-50%);width:30px;height:30px;padding:0;border:0;background:transparent;cursor:pointer;display:block;}
  .beacon-glow{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:12px;height:12px;border-radius:50%;background:radial-gradient(circle,rgba(255,196,128,.95) 0%,rgba(232,118,43,.55) 45%,rgba(232,118,43,0) 72%);box-shadow:0 0 10px 3px rgba(232,118,43,.45);transition:width .35s cubic-bezier(.2,.7,.2,1),height .35s,box-shadow .35s;}
  .beacon-ring{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(.4);width:30px;height:30px;border-radius:50%;border:1.5px solid rgba(255,196,128,.85);opacity:0;transition:opacity .35s,transform .35s cubic-bezier(.2,.7,.2,1);}
  .beacon-ring::after{content:"";position:absolute;inset:-1.5px;border-radius:50%;border:1.5px solid rgba(232,118,43,.5);animation:beaconPulse 3s ease-out infinite;}
  @keyframes beaconPulse{0%{transform:scale(.7);opacity:.6}70%{transform:scale(1.8);opacity:0}100%{opacity:0}}
  .beacon-chip{position:absolute;left:50%;bottom:calc(50% + 20px);transform:translateX(-50%) translateY(6px) scale(.96);opacity:0;pointer-events:none;white-space:nowrap;padding:7px 13px;border-radius:11px;background:rgba(12,18,32,.92);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.14);color:#fff;font-size:.84rem;font-weight:600;box-shadow:0 12px 30px -10px rgba(0,0,0,.8);transition:opacity .25s,transform .25s;}
  .beacon-chip::after{content:"";position:absolute;left:50%;top:100%;transform:translateX(-50%);border:6px solid transparent;border-top-color:rgba(12,18,32,.92);}
  .beacon:hover .beacon-glow,.beacon:focus-visible .beacon-glow{width:18px;height:18px;box-shadow:0 0 18px 6px rgba(232,118,43,.6);}
  .beacon:hover .beacon-ring,.beacon:focus-visible .beacon-ring{opacity:1;transform:translate(-50%,-50%) scale(1);}
  .beacon:hover .beacon-chip,.beacon:focus-visible .beacon-chip{opacity:1;transform:translateX(-50%) translateY(0) scale(1);}
  .beacon.is-active .beacon-glow{width:22px;height:22px;}
  .beacon:focus-visible{outline:none;}
  .beacon:focus-visible .beacon-ring{border-color:#fff;box-shadow:0 0 0 3px rgba(232,118,43,.5);}
  /* xray-tier beacons hidden until Look Inside is on */
  .beacon[data-tier="xray"]{opacity:0;pointer-events:none;transition:opacity .4s;}
  .photo-frame.xray-on .beacon[data-tier="xray"]{opacity:1;pointer-events:auto;}
  .photo-frame.xray-on .hero-photo{filter:brightness(.62) saturate(.8) hue-rotate(-6deg);}
  .photo-frame.xray-on .beacon[data-tier="visible"] .beacon-glow{background:radial-gradient(circle,rgba(150,210,255,.95) 0%,rgba(58,160,160,.5) 45%,rgba(58,160,160,0) 72%);box-shadow:0 0 10px 3px rgba(58,160,160,.4);}

  /* ---- look inside toggle ---- */
  .xray-toggle{position:absolute;top:16px;right:16px;z-index:53;display:inline-flex;align-items:center;gap:7px;padding:9px 15px;border-radius:999px;border:1px solid rgba(255,255,255,.2);background:rgba(12,18,32,.66);backdrop-filter:blur(10px);color:#fff;font-size:.84rem;font-weight:600;cursor:pointer;transition:background .25s,border-color .25s,transform .2s;}
  .xray-toggle:hover{background:rgba(12,18,32,.85);transform:translateY(-1px);}
  .xray-toggle[aria-pressed="true"]{background:rgba(58,160,160,.3);border-color:rgba(120,210,210,.6);}

  /* ---- in-page diagnostic panel ---- */
  .diag-backdrop{position:absolute;inset:0;z-index:60;border:0;padding:0;margin:0;background:transparent;cursor:default;opacity:0;transition:opacity .4s;}
  .diag-backdrop.is-open{opacity:1;}
  .diag{position:absolute;left:0;right:0;bottom:0;padding:clamp(18px,2.6vw,30px) clamp(18px,2.6vw,30px) clamp(18px,2.6vw,28px);background:linear-gradient(180deg,rgba(10,16,28,.4) 0%,rgba(8,13,24,.95) 24%,rgba(8,13,24,.99) 100%);backdrop-filter:blur(10px);border-top:1px solid rgba(255,255,255,.12);z-index:61;transform:translateY(101%);transition:transform .5s cubic-bezier(.2,.7,.2,1);max-height:88%;overflow-y:auto;overscroll-behavior:contain;}
  .diag.is-open{transform:translateY(0);}
  .diag[hidden]{display:block;}
  .diag-close{position:sticky;float:right;top:0;z-index:62;width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.22);background:rgba(20,28,44,.92);color:#fff;font-size:1.4rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;margin:-4px -4px 0 0;transition:background .2s,transform .15s;}
  .diag-close:hover{background:rgba(255,255,255,.18);transform:scale(1.06);}
  .diag-close:hover{background:rgba(255,255,255,.16);}
  .diag-eyebrow{margin:0 0 4px;font-size:.72rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#E8762B;}
  .diag-title{margin:0 0 8px;font-size:clamp(1.3rem,2vw,1.7rem);font-weight:800;color:#fff;letter-spacing:-.01em;}
  .diag-blurb{margin:0 0 14px;font-size:1rem;line-height:1.5;color:rgba(255,255,255,.82);max-width:52ch;}
  .diag-concerns-label{margin:0 0 7px;font-size:.82rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:rgba(255,255,255,.55);}
  .diag-concerns{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-wrap:wrap;gap:7px;}
  .diag-concerns li{font-size:.86rem;color:rgba(255,255,255,.78);padding:5px 11px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);}
  .diag-q{margin:0 0 10px;font-size:1.05rem;font-weight:700;color:#fff;}
  .diag-options{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:20px;}
  .diag-opt{display:inline-flex;align-items:center;gap:9px;padding:11px 16px;border-radius:13px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.05);color:#fff;font-size:.95rem;cursor:pointer;transition:border-color .2s,background .2s,transform .15s;}
  .diag-opt:hover{border-color:rgba(232,118,43,.6);background:rgba(232,118,43,.1);transform:translateY(-1px);}
  .diag-opt[aria-checked="true"]{border-color:#E8762B;background:rgba(232,118,43,.2);}
  .diag-opt .dot{width:14px;height:14px;border-radius:50%;border:2px solid rgba(255,255,255,.45);flex:0 0 auto;transition:border-color .2s,background .2s;}
  .diag-opt[aria-checked="true"] .dot{border-color:#E8762B;background:#E8762B;box-shadow:inset 0 0 0 3px rgba(8,13,24,.9);}
  .diag-go{display:inline-flex;align-items:center;gap:8px;background:#E8762B;color:#fff;font-weight:700;font-size:1rem;text-decoration:none;padding:13px 24px;border-radius:13px;box-shadow:0 10px 26px -8px rgba(232,118,43,.65);transition:filter .2s,transform .2s,opacity .2s;}
  .diag-go:hover{filter:brightness(1.06);transform:translateY(-1px);}
  .diag-go svg{transition:transform .2s;}
  .diag-go:hover svg{transform:translateX(3px);}

  /* global Ask Rocco drawer must not capture clicks while hidden (it stays display:flex;opacity:0) */
  :global(#rocco-panel[hidden]){pointer-events:none !important;}

  /* ---- reduced motion ---- */
  @media (prefers-reduced-motion: reduce){.beacon-ring::after{animation:none;}.diag{transition:none;}.rocco-figure,.hero-photo,.stage-scrim{transition:none;}}

  /* ---- mobile: text + card first, then image; Rocco scales; hide xray ---- */
  @media (max-width:920px){
    .hero-grid{grid-template-columns:1fr;gap:22px;align-items:stretch;}
    .hero-left{max-width:none;order:1;justify-self:stretch;align-self:stretch;}
    .hero-mid{order:2;justify-content:center;margin-top:4px;}
    .rocco-figure{height:min(46vh,360px);margin-right:0;margin-bottom:0;}
    .hero-right{order:3;}
    .photo-frame{height:min(60vh,500px);}
  }
  @media (max-width:560px){
    .trust-points{grid-template-columns:1fr;}
    .photo-frame{border-radius:18px;aspect-ratio:4 / 5;height:auto;}
    .hero-mid{display:none;}
    .beacon[data-sys="gutters"],.beacon[data-sys="window"]{display:none;}
    .askbar{flex-direction:column;}
    .askbar-go{justify-content:center;}
    .diag-options{flex-direction:column;}
    .diag-opt{width:100%;}
  }

  /* ============ BUTTONS ============ */
  .btn-primary{display:inline-flex;align-items:center;gap:.5rem;background:var(--emg-orange,#E8762B);color:#fff;font-weight:700;text-decoration:none;border-radius:999px;padding:1rem 2rem;transition:transform .25s cubic-bezier(.2,.7,.2,1),box-shadow .25s,background .25s}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 20px 40px -16px rgba(232,118,43,.6);background:#F4882F}
  .btn-xl{font-size:17px;padding:18px 34px;}

  /* ===================================================================
     EMG EXPERIENCE SYSTEM — the homepage as one continuous journey.
     =================================================================== */
  .chapter{max-width:1080px;margin:0 auto;padding:clamp(72px,11vw,150px) 24px;}
  .ch-head{max-width:760px;margin:0 auto clamp(40px,6vw,72px);text-align:center;}
  .ch-kicker{margin:0 0 14px;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#e8804e;}
  .ch-kicker-light{color:#ffb784;}
  .ch-title{margin:0;font-size:clamp(30px,4.6vw,52px);line-height:1.08;letter-spacing:-.02em;font-weight:800;color:#0f1b33;}
  .ch-lede{margin:20px auto 0;max-width:600px;font-size:clamp(16px,2vw,19px);line-height:1.6;color:#54607a;}
  .ch-path{background:linear-gradient(180deg,#fbfaf7 0%,#f4f1ea 100%);max-width:none;}
  .ch-where{background:#fff;max-width:none;}
  .ch-trust{background:#0f1b33;color:#fff;max-width:none;}
  .ch-trust .ch-title{color:#fff;}
  .ch-trust .ch-kicker{color:#ffb784;}
  .trust-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;max-width:900px;margin:0 auto;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08);border-radius:22px;overflow:hidden;}
  .trust-principle{padding:34px 30px;background:#0f1b33;}
  .trust-principle h3{margin:0 0 12px;font-size:19px;font-weight:750;color:#fff;line-height:1.25;}
  .trust-principle p{margin:0;font-size:15px;line-height:1.6;color:rgba(255,255,255,.72);}
  .ch-rocco{max-width:none;background:linear-gradient(180deg,#fff6ef 0%,#fdeee2 100%);}
  .rocco-inner{display:grid;grid-template-columns:auto 1fr;gap:clamp(28px,5vw,64px);align-items:center;max-width:920px;margin:0 auto;}
  .rocco-portrait{position:relative;width:200px;height:200px;flex:none;}
  .rocco-portrait img{position:relative;z-index:1;width:200px;height:200px;border-radius:50%;object-fit:cover;box-shadow:0 24px 50px -22px rgba(120,60,20,.5);}
  .rocco-ring{position:absolute;inset:-12px;border-radius:50%;border:1.5px solid rgba(232,128,78,.4);}
  .rocco-copy h2{margin:6px 0 16px;font-size:clamp(26px,3.6vw,40px);line-height:1.1;letter-spacing:-.02em;color:#3a2415;font-weight:800;}
  .rocco-copy p{margin:0 0 14px;font-size:16.5px;line-height:1.62;color:#6b513c;max-width:560px;}
  .rocco-quiet{color:#8a6a50;}
  .btn-light{display:inline-block;margin-top:10px;padding:14px 26px;border-radius:999px;background:#e8804e;color:#fff;font-weight:700;text-decoration:none;box-shadow:0 16px 32px -16px rgba(232,128,78,.7);transition:transform .25s ease;}
  .btn-light:hover{transform:translateY(-2px);}
  .ch-pilot{background:#fff;max-width:none;}
  .pilot-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;max-width:900px;margin:0 auto;}
  .pilot-fact{padding:30px 26px;border-radius:20px;background:#fbfaf7;border:1px solid rgba(15,27,51,.08);}
  .pilot-fact h3{margin:0 0 10px;font-size:18px;font-weight:750;color:#0f1b33;}
  .pilot-fact p{margin:0;font-size:14.5px;line-height:1.55;color:#5a647c;}
  .closing{max-width:none;text-align:center;padding:clamp(80px,12vw,160px) 24px;background:linear-gradient(180deg,#f4f1ea 0%,#fff 100%);}
  .closing-kicker{margin:0 0 14px;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#e8804e;}
  .closing-title{margin:0;font-size:clamp(32px,5.2vw,60px);line-height:1.05;letter-spacing:-.025em;font-weight:850;color:#0f1b33;}
  .closing-sub{margin:18px auto 32px;max-width:520px;font-size:17px;line-height:1.6;color:#54607a;}
  .closing-area{margin:30px auto 0;max-width:560px;font-size:13.5px;line-height:1.6;color:#8a93a6;}
  @media (max-width:760px){
    .rocco-inner{grid-template-columns:1fr;text-align:center;justify-items:center;}
    .rocco-copy p{margin-left:auto;margin-right:auto;}
    .chapter{padding:64px 22px;}
    .trust-principle{padding:26px 24px;}
    .closing{padding:72px 22px;}
  }
  .ch-narrow{max-width:760px;margin:0 auto;text-align:center;}
  .ch-lede-center{margin-left:auto;margin-right:auto;}
  .ch-soft{color:#5b6678;font-weight:600;}
  .path-steps{list-style:none;margin:2.6rem auto 0;padding:0;max-width:620px;text-align:left;display:grid;gap:1.15rem;counter-reset:step;}
  .path-steps li{position:relative;padding-left:2.4rem;font-size:1.04rem;line-height:1.55;color:#46536a;counter-increment:step;}
  .path-steps li::before{content:counter(step);position:absolute;left:0;top:.05em;width:1.6rem;height:1.6rem;border-radius:50%;background:rgba(232,118,43,.1);color:var(--emg-orange,#E8762B);font-size:.78rem;font-weight:700;display:flex;align-items:center;justify-content:center;}
  .path-n{color:var(--emg-navy,#0f1b30);font-weight:700;}
  .where-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:2.4rem auto 0;max-width:520px;}
  .where-link{display:flex;flex-direction:column;gap:.15rem;padding:.7rem 1.15rem;border-radius:14px;background:rgba(255,255,255,.72);border:1px solid rgba(15,27,51,.08);text-decoration:none;transition:transform .4s cubic-bezier(.2,.7,.2,1),border-color .4s,background .4s;}
  .where-link:hover,.where-link:focus-visible{transform:translateY(-2px);border-color:rgba(232,118,43,.5);background:#fff;}
  .where-link-label{font-size:1rem;font-weight:700;color:var(--emg-navy,#0f1b30);}
  .where-link-hint{font-size:.82rem;color:#6a7588;}
  @media (max-width:600px){.trust-grid{grid-template-columns:1fr;}.where-row{grid-template-columns:1fr;max-width:340px;}}
</style>

<script is:inline define:vars={{ systems }}>
/* Interactive Home Engine. Clicking a beacon focuses the house and opens an in-page
   diagnostic; only after a symptom is chosen do we hand off to /ask with full context.
   No navigation on beacon click. Backend (functions/sessions/consent/ARS/Rocco) untouched. */
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var stage = document.getElementById('stage');
  var diag = document.getElementById('diag');
  if(!stage || !diag) return;
  var byKey = {}; systems.forEach(function(s){ byKey[s.key] = s; });
  var elEyebrow = document.getElementById('diagEyebrow');
  var elTitle = document.getElementById('diagTitle');
  var elBlurb = document.getElementById('diagBlurb');
  var elConcerns = document.getElementById('diagConcerns');
  var elOptions = document.getElementById('diagOptions');
  var elGo = document.getElementById('diagGo');
  var current = null, chosen = null, lastBeacon = null;

  function buildGo(){
    var base = '/ask?topic=' + encodeURIComponent(current.topic) + '&system=' + encodeURIComponent(current.key);
    if(chosen && chosen !== 'Other'){ base += '&symptom=' + encodeURIComponent(chosen); }
    var q = chosen && chosen !== 'Other' ? (current.label + ': ' + chosen) : ('I have a question about my ' + current.label.toLowerCase());
    base += '&q=' + encodeURIComponent(q);
    elGo.setAttribute('href', base);
  }

  function openSystem(key, beaconEl){
    var s = byKey[key]; if(!s) return; current = s; chosen = null;
    elEyebrow.textContent = s.tier === 'xray' ? 'Inside your home' : 'Your home';
    elTitle.textContent = s.label;
    elBlurb.textContent = s.blurb;
    elConcerns.innerHTML = '';
    s.concerns.forEach(function(c){ var li=document.createElement('li'); li.textContent=c; elConcerns.appendChild(li); });
    elOptions.innerHTML = '';
    s.symptoms.forEach(function(sym){
      var b=document.createElement('button'); b.type='button'; b.className='diag-opt'; b.setAttribute('role','radio'); b.setAttribute('aria-checked','false');
      var dot=document.createElement('span'); dot.className='dot'; dot.setAttribute('aria-hidden','true');
      var t=document.createElement('span'); t.textContent=sym;
      b.appendChild(dot); b.appendChild(t);
      b.addEventListener('click', function(){
        chosen = sym;
        Array.prototype.forEach.call(elOptions.children, function(o){ o.setAttribute('aria-checked','false'); });
        b.setAttribute('aria-checked','true'); buildGo();
      });
      elOptions.appendChild(b);
    });
    buildGo();
    // focus the house on the beacon location
    stage.style.setProperty('--fx', s.x + '%');
    stage.style.setProperty('--fy', s.y + '%');
    stage.classList.add('is-focused');
    Array.prototype.forEach.call(document.querySelectorAll('.beacon'), function(b){ b.classList.remove('is-active'); });
    if(beaconEl) beaconEl.classList.add('is-active');
    lastBeacon = beaconEl || null;
    document.getElementById('diagBackdrop').hidden = false;
    var bd = document.getElementById('diagBackdrop'); void bd.offsetWidth; bd.classList.add('is-open');
    diag.hidden = false; void diag.offsetWidth; diag.classList.add('is-open');
    diag.scrollTop = 0;
    var cb = document.getElementById('diagClose'); if(cb && cb.focus){ try{ cb.focus({preventScroll:true}); }catch(e){ cb.focus(); } }
  }

  function closeDiag(){
    if(!diag.classList.contains('is-open') && diag.hidden){ return; }
    diag.classList.remove('is-open');
    var bd = document.getElementById('diagBackdrop'); bd.classList.remove('is-open');
    stage.classList.remove('is-focused');
    Array.prototype.forEach.call(document.querySelectorAll('.beacon'), function(b){ b.classList.remove('is-active'); });
    var ret = lastBeacon;
    current = null; chosen = null;
    setTimeout(function(){ if(!diag.classList.contains('is-open')){ diag.hidden = true; bd.hidden = true; } }, reduce ? 0 : 480);
    if(ret && ret.focus){ try{ ret.focus({preventScroll:true}); }catch(e){ ret.focus(); } }
    lastBeacon = null;
  }

  Array.prototype.forEach.call(document.querySelectorAll('.beacon'), function(b){
    b.addEventListener('click', function(){ openSystem(b.getAttribute('data-sys'), b); });
  });
  document.getElementById('diagClose').addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); closeDiag(); });
  document.getElementById('diagBackdrop').addEventListener('click', function(e){ e.preventDefault(); closeDiag(); });
  document.addEventListener('keydown', function(e){ if((e.key==='Escape'||e.key==='Esc') && diag.classList.contains('is-open')){ e.preventDefault(); closeDiag(); } });

  // Look Inside toggle
  var xray = document.getElementById('xrayToggle');
  if(xray){ xray.addEventListener('click', function(){
    var on = stage.classList.toggle('xray-on');
    xray.setAttribute('aria-pressed', on ? 'true' : 'false');
    xray.querySelector('.xray-label').textContent = on ? 'Exit' : 'Look inside';
    if(!on && current && byKey[current.key] && byKey[current.key].tier==='xray') closeDiag();
  }); }

  // scroll reveal
  var items = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window && !reduce){
    var io = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.14 });
    items.forEach(function(el){ io.observe(el); });
  } else { items.forEach(function(el){ el.classList.add('in'); }); }

  // greeting placeholder in the ask bar
  var input = document.querySelector('[data-greeting]');
  if(input){ var msg='e.g. brown stain on my ceiling\u2026';
    if(reduce){ input.setAttribute('placeholder', msg); }
    else { var i=0; (function typeIt(){ input.setAttribute('placeholder', msg.slice(0,i) + (i<msg.length?'\u2502':'')); if(i<=msg.length){ i++; setTimeout(typeIt,38); } else { input.setAttribute('placeholder', msg); } })(); }
  }
})();
</script>
