  /* ============ HOUSE v2 — premium dusk illustration + system interaction ============ */
  .stage{max-width:900px;aspect-ratio:1200/820}
  .stage-house{width:100%;transform-origin:50% 88%}
  /* environment motion */
  .h-clouds{animation:hCloud 26s linear infinite}
  @keyframes hCloud{from{transform:translateX(0)}to{transform:translateX(40px)}}
  .h-smoke{transform-origin:675px 180px;animation:hSmoke 7s ease-in-out infinite}
  @keyframes hSmoke{0%{opacity:.30;transform:translateY(0) scale(1)}50%{opacity:.18;transform:translateY(-10px) scale(1.06)}100%{opacity:.30;transform:translateY(0) scale(1)}}
  .h-smoke circle{animation:hSmokeRise 7s ease-in-out infinite}
  @keyframes hSmokeRise{0%{opacity:.05}40%{opacity:.35}100%{opacity:0}}
  .h-particles circle{animation:hFloat 9s ease-in-out infinite}
  .h-particles circle:nth-child(2){animation-delay:1.4s}
  .h-particles circle:nth-child(3){animation-delay:2.8s}
  .h-particles circle:nth-child(4){animation-delay:.7s}
  .h-particles circle:nth-child(5){animation-delay:3.6s}
  @keyframes hFloat{0%,100%{transform:translateY(0);opacity:.25}50%{transform:translateY(-12px);opacity:.6}}
  .h-winA,.h-winB{transform-origin:center;animation:hWinPulse 5.5s ease-in-out infinite}
  .h-winB{animation-delay:1.6s}
  @keyframes hWinPulse{0%,100%{opacity:1}50%{opacity:.92}}
  .h-porchlight{animation:hPorch 4s ease-in-out infinite}
  @keyframes hPorch{0%,100%{opacity:.9}50%{opacity:.65}}
