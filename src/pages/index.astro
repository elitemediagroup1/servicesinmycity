      sp.addColorStop(0,'rgba(255,207,133,'+(0.28*pulse)+')');sp.addColorStop(1,'rgba(255,207,133,0)');
      ctx.fillStyle=sp;ctx.fillRect(wx-ww,wy-wh*0.5,ww*3,wh*2.2);
      var wg=ctx.createRadialGradient(wx+ww/2,wy+wh*0.4,0,wx+ww/2,wy+wh*0.4,ww);
      wg.addColorStop(0,'rgba(255,240,194,'+pulse+')');wg.addColorStop(.6,'rgba(255,206,125,'+(pulse*0.9)+')');wg.addColorStop(1,'rgba(246,169,78,0.7)');
      ctx.fillStyle=wg;ctx.fillRect(wx,wy,ww,wh);
      ctx.strokeStyle='rgba(60,40,20,0.55)';ctx.lineWidth=2;ctx.strokeRect(wx,wy,ww,wh);
      ctx.beginPath();ctx.moveTo(wx+ww/2,wy);ctx.lineTo(wx+ww/2,wy+wh);ctx.moveTo(wx,wy+wh/2);ctx.lineTo(wx+ww,wy+wh/2);ctx.stroke();
    }
    var ww=hw*0.14,wh=hh*0.30;
    win(hx+hw*0.12,hy+hh*0.22,ww,wh,0);
    win(hx+hw*0.74,hy+hh*0.22,ww,wh,1.3);
    win(hx+hw*0.12,baseY-hh*0.42,ww*0.9,wh*0.9,2.1);
    ctx.restore();
    /* smoke */
    var sx=hx+hw*0.66+11, sy=hy-hh*0.34;
    if(!reduce && t-lastPuff>520){lastPuff=t;smoke.push({x:sx,y:sy,r:6,a:0.5,vx:(Math.random()-0.5)*0.15,vy:-0.32});}
    for(var s=smoke.length-1;s>=0;s--){var p=smoke[s];p.x+=p.vx;p.y+=p.vy;p.r+=0.22;p.a-=0.0028;p.vx+=(Math.random()-0.5)*0.02;
      if(p.a<=0){smoke.splice(s,1);continue;}ctx.fillStyle='rgba(200,200,205,'+p.a+')';ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,7);ctx.fill();}
    /* X-Ray reveal */
    xray += (xrayTarget - xray)*0.12;
    if(xray>0.01){
      var a=xray;
      ctx.fillStyle='rgba(8,12,24,'+(0.42*a)+')';ctx.fillRect(0,0,W,H);
      if(xrayKey==='roof'){
        var ag=ctx.createLinearGradient(0,hy-hh*0.55,0,hy);ag.addColorStop(0,'rgba(120,180,255,0)');ag.addColorStop(1,'rgba(120,180,255,'+(0.20*a)+')');
        ctx.fillStyle=ag;ctx.beginPath();ctx.moveTo(hx-10,hy+4);ctx.lineTo(cx,hy-hh*0.5);ctx.lineTo(hx+hw+10,hy+4);ctx.closePath();ctx.fill();
        ctx.fillStyle='rgba(255,210,140,'+(0.5*a)+')';
        for(var b=0;b<6;b++){var bx=hx+30+b*(hw-60)/6;ctx.beginPath();ctx.ellipse(bx,hy-6,(hw-60)/14,7,0,0,7);ctx.fill();}
        ctx.strokeStyle='rgba(120,190,255,'+(0.6*a)+')';ctx.lineWidth=2;
        for(var c=0;c<4;c++){var ttx=hx+hw*0.25+c*hw*0.17;ctx.beginPath();
          for(var yv=0;yv<hh*0.5;yv+=4){var off=Math.sin((yv*0.06)+t*0.002+c)*6;ctx.lineTo(ttx+off,hy-yv);}ctx.stroke();}
      } else if(xrayKey==='plumb'){
        ctx.strokeStyle='rgba(90,200,255,'+(0.8*a)+')';ctx.lineWidth=3;ctx.lineCap='round';
        ctx.beginPath();ctx.moveTo(hx+hw*0.2,baseY-6);ctx.lineTo(hx+hw*0.2,hy+hh*0.4);ctx.lineTo(hx+hw*0.75,hy+hh*0.4);ctx.lineTo(hx+hw*0.75,baseY-6);ctx.stroke();
        var fl=(t*0.12)%(hw*0.55);
        ctx.fillStyle='rgba(150,225,255,'+a+')';ctx.beginPath();ctx.arc(hx+hw*0.2+fl,hy+hh*0.4,4,0,7);ctx.fill();
      } else if(xrayKey==='elec'){
        ctx.strokeStyle='rgba(255,210,90,'+(0.85*a)+')';ctx.lineWidth=2;
        for(var w=0;w<3;w++){ctx.beginPath();ctx.moveTo(hx+hw*0.7,hy+hh*0.55);
          for(var yv2=0;yv2<hh*0.4;yv2+=6){ctx.lineTo(hx+hw*0.7+Math.sin(yv2*0.3+w*2+t*0.004)*8,hy+hh*0.55-yv2);}ctx.stroke();}
        ctx.fillStyle='rgba(255,230,120,'+(0.9*a)+')';ctx.fillRect(hx+hw*0.66,hy+hh*0.5,16,22);
      } else if(xrayKey==='hvac'){
        ctx.strokeStyle='rgba(120,255,220,'+(0.7*a)+')';ctx.lineWidth=10;ctx.lineCap='round';
        ctx.beginPath();ctx.moveTo(hx+hw*0.85,baseY-hh*0.3);ctx.lineTo(hx+hw*0.3,baseY-hh*0.3);ctx.lineTo(hx+hw*0.3,baseY-hh*0.6);ctx.stroke();
        for(var d=0;d<5;d++){var dp=((t*0.05+d*40)% (hw*0.55));ctx.fillStyle='rgba(180,255,235,'+(a*(1-dp/(hw*0.55)))+')';
          ctx.beginPath();ctx.arc(hx+hw*0.85-dp,baseY-hh*0.3,4,0,7);ctx.fill();}
      } else if(xrayKey==='struct'){
        ctx.fillStyle='rgba(150,170,200,'+(0.35*a)+')';ctx.fillRect(hx-6,baseY-4,hw+12,22);
        ctx.strokeStyle='rgba(180,200,230,'+(0.7*a)+')';ctx.lineWidth=2;ctx.strokeRect(hx-6,baseY-4,hw+12,22);
      }
    }
    if(!reduce || xray>0.01) raf=requestAnimationFrame(ndraw);
  }
  var raf=requestAnimationFrame(ndraw);

  /* wire hotspots -> X-Ray (overlay anchors already route to /ask) */
  var spots = stage.querySelectorAll('.hotspot');
  spots.forEach(function(a){
    var key = a.getAttribute('data-sys');
    function on(){ a.classList.add('is-active'); setXray(key); if(reduce){ raf=requestAnimationFrame(ndraw); } }
    function off(){ a.classList.remove('is-active'); setXray(null); if(reduce){ raf=requestAnimationFrame(ndraw); } }
    a.addEventListener('mouseenter', on);
    a.addEventListener('mouseleave', off);
    a.addEventListener('focus', on);
    a.addEventListener('blur', off);
  });
})();

  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* scroll reveal */
    var items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.14 });
      items.forEach(function (el) { io.observe(el); });
    } else {
      items.forEach(function (el) { el.classList.add('in'); });
    }

    /* time-based greeting typed into the ask bar placeholder */
    var input = document.querySelector('[data-greeting]');
    if (input) {
      var h = new Date().getHours();
      var part = h < 12 ? 'morning' : (h < 18 ? 'afternoon' : 'evening');
      var msg = 'Good ' + part + ' \u2014 what is going on with your home?';
      if (reduce) {
        input.setAttribute('placeholder', msg);
      } else {
        var i = 0;
        (function typeIt() {
          input.setAttribute('placeholder', msg.slice(0, i) + (i < msg.length ? '\u2502' : ''));
          if (i <= msg.length) { i++; setTimeout(typeIt, 38); }
          else { input.setAttribute('placeholder', msg); }
        })();
      }
    }

    /* gentle cursor parallax on the house */
    var stage = document.getElementById('stage');
    var wrap = stage && stage.querySelector('.home-wrap');
    if (stage && wrap && !reduce && window.matchMedia('(pointer:fine)').matches) {
      stage.addEventListener('mousemove', function (e) {
        var r = stage.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        wrap.style.transform = 'translate3d(' + (dx * 14).toFixed(1) + 'px,' + (dy * 10).toFixed(1) + 'px,0)';
      });
      stage.addEventListener('mouseleave', function () {
        wrap.style.transform = 'translate3d(0,0,0)';
      });
    }
  })();

  // ===== House system focus: illuminate hovered system, dim the rest =====
  (function(){
    var stage = document.querySelector(".house2 .stage");
    if(!stage) return;
    var svg = stage.querySelector(".stage-house");
    var sysWrap = stage.querySelector("#house-systems");
    var dim = stage.querySelector("#house-dim");
    if(!svg || !sysWrap || !dim) return;
    var NS = "http://www.w3.org/2000/svg";
    // Highlight shapes anchored to real geometry (viewBox 1200x820)
    var SHAPES = {
      roof:        '<path d="M352 322 L571 182 L606 182 L790 322 Z"/>',
      gutters:     '<rect x="346" y="314" width="450" height="18" rx="7"/><rect x="192" y="436" width="210" height="14" rx="6"/>',
      attic:       '<path d="M452 304 L571 230 L606 230 L706 304 Z"/>',
      hvac:        '<rect x="948" y="498" width="66" height="84" rx="8"/>',
      electrical:  '<rect x="806" y="426" width="52" height="86" rx="6"/>',
      plumbing:    '<rect x="688" y="430" width="60" height="176" rx="8"/>',
      waterheater: '<rect x="260" y="498" width="64" height="114" rx="10"/>',
      crawlspace:  '<rect x="372" y="598" width="398" height="22" rx="5"/>',
      foundation:  '<rect x="372" y="600" width="398" height="16" rx="3"/><rect x="214" y="598" width="166" height="16" rx="3"/>',
      garage:      '<rect x="236" y="476" width="122" height="136" rx="4"/>',
      kitchen:     '<rect x="406" y="370" width="92" height="108" rx="3"/>',
      bathroom:    '<rect x="600" y="370" width="92" height="108" rx="3"/>'
    };
    Object.keys(SHAPES).forEach(function(k){
      var g = document.createElementNS(NS,"g");
      g.setAttribute("data-sys",k); g.setAttribute("opacity","0");
      var raw = SHAPES[k];
      var glow = raw.replace(/<path/g,'<path filter="url(#h-blur)" fill="url(#h-sys)"').replace(/<rect/g,'<rect filter="url(#h-blur)" fill="url(#h-sys)"');
      var crisp = raw.replace(/<path/g,'<path fill="#fff1c9" opacity="0.5"').replace(/<rect/g,'<rect fill="#fff1c9" opacity="0.5"');
      g.innerHTML = glow + crisp;
      sysWrap.appendChild(g);
    });
    function activate(key){
      dim.setAttribute("opacity","0.55");
      sysWrap.querySelectorAll("g[data-sys]").forEach(function(g){
        g.setAttribute("opacity", g.getAttribute("data-sys")===key ? "1" : "0");
      });
    }
    function reset(){
      dim.setAttribute("opacity","0");
      sysWrap.querySelectorAll("g[data-sys]").forEach(function(g){ g.setAttribute("opacity","0"); });
    }
    stage.querySelectorAll(".hotspot").forEach(function(a){
      var key = a.getAttribute("data-sys");
      a.addEventListener("mouseenter", function(){ activate(key); });
      a.addEventListener("mouseleave", reset);
      a.addEventListener("focus", function(){ activate(key); });
      a.addEventListener("blur", reset);
    });
  })();
</script>
