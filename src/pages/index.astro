  .h-stars circle:nth-child(odd){animation-delay:1.5s}
  @keyframes hTwinkle{0%,100%{opacity:.5}50%{opacity:.15}}
  /* system focus: dim + glow transitions (driven by JS opacity) */
  #house-dim{transition:opacity .5s ease;pointer-events:none}
  #house-systems{pointer-events:none}
  #house-systems > g{transition:opacity .45s ease}
  /* hotspot dot refinement (works with existing .hotspot styles) */
  .hotspot{width:26px;height:26px}
  .hotspot:hover{z-index:5}
  @media (prefers-reduced-motion: reduce){
    .stage-house,.h-clouds,.h-smoke,.h-smoke circle,.h-particles circle,.h-winA,.h-winB,.h-porchlight,.h-stars circle{animation:none!important}
    #house-dim,#house-systems > g{transition:none}
  }
</style>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* scroll reveal */
    var items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.14 });
      items.forEach(function (el) { io.observe(el); });
    } else {
      items.forEach(function (el) { el.classList.add('in'); });
    }

    /* time-based greeting typed into the ask bar placeholder */
    var input = document.querySelector('[data-greeting]');
    if (input) {
      var h = new Date().getHours();
      var part = h < 12 ? 'morning' : (h < 18 ? 'afternoon' : 'evening');
      var msg = 'Good ' + part + ' \u2014 what is going on with your home?';
      if (reduce) {
        input.setAttribute('placeholder', msg);
      } else {
        var i = 0;
        (function typeIt() {
          input.setAttribute('placeholder', msg.slice(0, i) + (i < msg.length ? '\u2502' : ''));
          if (i <= msg.length) { i++; setTimeout(typeIt, 38); }
          else { input.setAttribute('placeholder', msg); }
        })();
      }
    }

    /* gentle cursor parallax on the house */
    var stage = document.getElementById('stage');
    var wrap = stage && stage.querySelector('.home-wrap');
    if (stage && wrap && !reduce && window.matchMedia('(pointer:fine)').matches) {
      stage.addEventListener('mousemove', function (e) {
        var r = stage.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        wrap.style.transform = 'translate3d(' + (dx * 14).toFixed(1) + 'px,' + (dy * 10).toFixed(1) + 'px,0)';
      });
      stage.addEventListener('mouseleave', function () {
        wrap.style.transform = 'translate3d(0,0,0)';
      });
    }
  })();

  // ===== House system focus: illuminate hovered system, dim the rest =====
  (function(){
    var stage = document.querySelector(".house2 .stage");
    if(!stage) return;
    var svg = stage.querySelector(".stage-house");
    var sysWrap = stage.querySelector("#house-systems");
    var dim = stage.querySelector("#house-dim");
    if(!svg || !sysWrap || !dim) return;
    var NS = "http://www.w3.org/2000/svg";
    // Highlight shapes anchored to real geometry (viewBox 1200x820)
    var SHAPES = {
      roof:        '<path d="M352 322 L571 182 L606 182 L790 322 Z"/>',
      gutters:     '<rect x="346" y="314" width="450" height="18" rx="7"/><rect x="192" y="436" width="210" height="14" rx="6"/>',
      attic:       '<path d="M452 304 L571 230 L606 230 L706 304 Z"/>',
      hvac:        '<rect x="948" y="498" width="66" height="84" rx="8"/>',
      electrical:  '<rect x="806" y="426" width="52" height="86" rx="6"/>',
      plumbing:    '<rect x="688" y="430" width="60" height="176" rx="8"/>',
      waterheater: '<rect x="260" y="498" width="64" height="114" rx="10"/>',
      crawlspace:  '<rect x="372" y="598" width="398" height="22" rx="5"/>',
      foundation:  '<rect x="372" y="600" width="398" height="16" rx="3"/><rect x="214" y="598" width="166" height="16" rx="3"/>',
      garage:      '<rect x="236" y="476" width="122" height="136" rx="4"/>',
      kitchen:     '<rect x="406" y="370" width="92" height="108" rx="3"/>',
      bathroom:    '<rect x="600" y="370" width="92" height="108" rx="3"/>'
    };
    Object.keys(SHAPES).forEach(function(k){
      var g = document.createElementNS(NS,"g");
      g.setAttribute("data-sys",k); g.setAttribute("opacity","0");
      var raw = SHAPES[k];
      var glow = raw.replace(/<path/g,'<path filter="url(#h-blur)" fill="url(#h-sys)"').replace(/<rect/g,'<rect filter="url(#h-blur)" fill="url(#h-sys)"');
      var crisp = raw.replace(/<path/g,'<path fill="#fff1c9" opacity="0.5"').replace(/<rect/g,'<rect fill="#fff1c9" opacity="0.5"');
      g.innerHTML = glow + crisp;
      sysWrap.appendChild(g);
    });
    function activate(key){
      dim.setAttribute("opacity","0.55");
      sysWrap.querySelectorAll("g[data-sys]").forEach(function(g){
        g.setAttribute("opacity", g.getAttribute("data-sys")===key ? "1" : "0");
      });
    }
    function reset(){
      dim.setAttribute("opacity","0");
      sysWrap.querySelectorAll("g[data-sys]").forEach(function(g){ g.setAttribute("opacity","0"); });
    }
    stage.querySelectorAll(".hotspot").forEach(function(a){
      var key = a.getAttribute("data-sys");
      a.addEventListener("mouseenter", function(){ activate(key); });
      a.addEventListener("mouseleave", reset);
      a.addEventListener("focus", function(){ activate(key); });
      a.addEventListener("blur", reset);
    });
  })();
</script>
