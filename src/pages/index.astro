---
import BaseLayout from '../layouts/BaseLayout.astro';
import SafeImage from "../components/SafeImage.astro";

/* PHASE 2.5 - Polish pass. Homepage as a living product experience.
   No fabricated stats/reviews. Only real asset is the Rocco headshot;
   the interactive house is pure SVG/CSS so it is premium and art-independent.
   Backend (functions, sessions, consent, ARS, Rocco intelligence) untouched. */

const services = [
  { slug: 'hvac',       label: 'Heating &amp; Cooling', hint: 'No heat, no cool, weird noises' },
  { slug: 'plumbing',   label: 'Plumbing',              hint: 'Leaks, clogs, water heaters' },
  { slug: 'electrical', label: 'Electrical',            hint: 'Breakers, outlets, panels' },
  { slug: 'roofing',    label: 'Roofing',               hint: 'Leaks, shingles, storm damage' },
];

/* House hotspots positioned over the SVG home (x/y are % within the stage).
   Each deep-links into Ask Rocco with topic context. */
const hotspots = [
  { key: 'roof',        label: 'Roof',            x: 47.6, y: 30.5 },
  { key: 'gutters',     label: 'Gutters',         x: 30.8, y: 39.3 },
  { key: 'attic',       label: 'Attic',           x: 48.5, y: 31.5 },
  { key: 'hvac',        label: 'HVAC',            x: 81.7, y: 65.9 },
  { key: 'electrical',  label: 'Electrical Panel',x: 69.3, y: 57.3 },
  { key: 'plumbing',    label: 'Plumbing',        x: 59.8, y: 60.0 },
  { key: 'waterheater', label: 'Water Heater',    x: 24.3, y: 67.5 },
  { key: 'crawlspace',  label: 'Crawlspace',      x: 47.5, y: 74.5 },
  { key: 'foundation',  label: 'Foundation',      x: 36.7, y: 75.0 },
  { key: 'garage',      label: 'Garage',          x: 24.8, y: 65.9 },
  { key: 'kitchen',     label: 'Kitchen',         x: 37.7, y: 51.7 },
  { key: 'bathroom',    label: 'Bathroom',        x: 53.8, y: 51.7 },
];

const prompts = [
  'My AC is blowing warm air',
  'Brown stain on my ceiling',
  'My breaker keeps tripping',
  'Water pressure dropped',
];
---

<BaseLayout title="The home guide that knows what&rsquo;s wrong" description="ServicesInMyCity is the AI guide for your home. Ask Rocco what&rsquo;s wrong before anyone touches it &mdash; then connect with a trusted local pro.">

  <!-- ===================== HERO ===================== -->
  <section class="hero2" aria-label="Ask Rocco">
    <div class="hero2-aurora" aria-hidden="true"></div>
    <div class="hero2-grain" aria-hidden="true"></div>
    <div class="hero2-inner">
      <p class="hero2-eyebrow reveal">The AI guide for your home</p>
      <h1 class="hero2-title reveal">
        Know what&rsquo;s wrong with your home<br />
        <span class="hero2-title-accent">before anyone touches it.</span>
      </h1>
      <p class="hero2-lede reveal">
        Describe what&rsquo;s happening in plain words. Rocco helps you understand it,
        what it might cost, and what to ask &mdash; then connects you with a trusted local pro.
      </p>

      <form class="askbar reveal" action="/ask" method="get" role="search">
        <span class="askbar-rocco" aria-hidden="true">
          <img src="/assets/rocco/rocco-headshot.png" alt="" width="40" height="40" />
          <span class="askbar-pulse"></span>
        </span>
        <input class="askbar-input" type="text" name="q" autocomplete="off"
          aria-label="Describe what is happening with your home"
          placeholder="" data-greeting="1" />
        <button class="askbar-go" type="submit">
          Ask Rocco
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>

      <div class="hero2-prompts reveal" aria-label="Examples">
        {prompts.map((p) => (
          <a class="chip" href={`/ask?q=${encodeURIComponent(p)}`}>{p}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== THE HOUSE ===================== -->
  <section class="house2" aria-labelledby="house2-title">
    <div class="house2-head reveal">
      <h2 id="house2-title" class="house2-title">Point to where it hurts.</h2>
      <p class="house2-sub">Every part of your home is a question Rocco can answer. Hover a spot &mdash; then ask.</p>
    </div>

    <div class="stage reveal" id="stage" data-parallax>
      <!-- ambient sky + drifting clouds -->
      <div class="sky" aria-hidden="true">
        <span class="cloud cloud-a"></span>
        <span class="cloud cloud-b"></span>
        <span class="cloud cloud-c"></span>
        <span class="bird" aria-hidden="true"></span>
      </div>

      <!-- the home itself (breathes + parallax) -->
      <div class="home-wrap" data-depth="0.4">
        <span class="chimney-smoke" aria-hidden="true"><i></i><i></i><i></i></span>
  <svg class="stage-house" viewBox="0 0 1200 820" preserveAspectRatio="xMidYMid meet" role="img" aria-label="An illustrated home at dusk with warmly lit windows">
    <defs>
      <linearGradient id="h-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#14213d"/><stop offset=".40" stop-color="#22314f"/><stop offset=".66" stop-color="#5a4a64"/><stop offset=".82" stop-color="#b5707a"/><stop offset=".93" stop-color="#e2916b"/><stop offset="1" stop-color="#f0b079"/></linearGradient>
      <radialGradient id="h-moon" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fbf3df" stop-opacity=".55"/><stop offset="1" stop-color="#fbf3df" stop-opacity="0"/></radialGradient>
      <linearGradient id="h-ground" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b3d33"/><stop offset="1" stop-color="#14201a"/></linearGradient>
      <linearGradient id="h-wallF" x1="0" y1="0" x2="1" y2=".3"><stop offset="0" stop-color="#d8c4a8"/><stop offset=".5" stop-color="#e7d7bd"/><stop offset="1" stop-color="#cdb89a"/></linearGradient>
      <linearGradient id="h-wallS" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a89274"/><stop offset="1" stop-color="#8a7459"/></linearGradient>
      <linearGradient id="h-roofM" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#46414f"/><stop offset="1" stop-color="#322d39"/></linearGradient>
      <linearGradient id="h-roofS" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2c2833"/><stop offset="1" stop-color="#201d27"/></linearGradient>
      <radialGradient id="h-win" cx=".5" cy=".42" r=".75"><stop offset="0" stop-color="#fff0c2"/><stop offset=".5" stop-color="#ffce7d"/><stop offset="1" stop-color="#f6a94e"/></radialGradient>
      <radialGradient id="h-spill" cx=".5" cy=".1" r=".9"><stop offset="0" stop-color="#ffcf85" stop-opacity=".5"/><stop offset=".5" stop-color="#ffcf85" stop-opacity=".1"/><stop offset="1" stop-color="#ffcf85" stop-opacity="0"/></radialGradient>
      <radialGradient id="h-porch" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffe6a8" stop-opacity=".9"/><stop offset="1" stop-color="#ffe6a8" stop-opacity="0"/></radialGradient>
      <radialGradient id="h-sys" cx=".5" cy=".5" r=".6"><stop offset="0" stop-color="#ffd98a" stop-opacity=".95"/><stop offset="1" stop-color="#ff9b45" stop-opacity=".35"/></radialGradient>
      <pattern id="h-shingle" width="34" height="16" patternUnits="userSpaceOnUse"><path d="M0 15 L34 15" stroke="#000" stroke-opacity=".18" stroke-width="1.5"/><path d="M0 8 L17 8 M17 0 L17 8 M0 0 L0 8 M34 0 L34 8" stroke="#000" stroke-opacity=".10" stroke-width="1"/></pattern>
      <filter id="h-soft" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="7"/></filter>
      <filter id="h-soft2" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="3"/></filter>
      <filter id="h-blur" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="10"/></filter>
    </defs>
    <!-- ENVIRONMENT: blue-hour dusk sky, moon, treeline, ground, warm light spill -->
    <rect x="0" y="0" width="1200" height="640" fill="url(#h-sky)"/>
    <g class="h-stars" fill="#fff" opacity=".5"><circle cx="120" cy="80" r="1.3"/><circle cx="300" cy="140" r="1"/><circle cx="520" cy="60" r="1.4"/><circle cx="760" cy="110" r="1"/><circle cx="1040" cy="70" r="1.3"/><circle cx="200" cy="200" r="1"/><circle cx="980" cy="180" r="1"/><circle cx="660" cy="160" r="1.1"/></g>
    <circle cx="940" cy="160" r="150" fill="url(#h-moon)"/><circle cx="940" cy="160" r="40" fill="#f7efd8"/><circle cx="958" cy="150" r="40" fill="#22314f" opacity=".35"/>
    <g class="h-clouds" fill="#1a2336" opacity=".9"><path d="M-20 560 Q60 470 140 560 Q200 500 270 560 Z"/><path d="M1000 560 Q1070 470 1150 560 Q1200 510 1230 560 Z"/></g>
    <rect x="0" y="560" width="1200" height="260" fill="url(#h-ground)"/>
    <ellipse cx="600" cy="690" rx="540" ry="66" fill="#000" opacity=".3" filter="url(#h-soft)"/>
    <ellipse cx="560" cy="640" rx="420" ry="120" fill="url(#h-spill)"/>
    <!-- =====================================================================
         HOUSE BASE ART (Phase 1 hand-built SVG illustration).
         REPLACEABLE: to swap in a commissioned raster/3D render later,
         replace this entire <g id="house-base"> with a single
         <image href="/art/home-render.webp" x=".." y=".." width=".." height=".."/>.
         The #house-systems, #house-dim layers and the .hotspots overlay
         stay reusable and keep the same /ask?topic={label} handoff.
    ===================================================================== -->
    <g id="house-base">
      <path d="M770 318 L905 360 L905 612 L770 612 Z" fill="url(#h-wallS)"/>
      <g stroke="#000" stroke-opacity=".08" stroke-width="2"><path d="M770 360 L905 398"/><path d="M770 400 L905 432"/><path d="M770 440 L905 466"/><path d="M770 480 L905 500"/><path d="M770 520 L905 534"/><path d="M770 560 L905 568"/></g>
      <rect x="372" y="318" width="398" height="294" fill="url(#h-wallF)"/>
      <g stroke="#000" stroke-opacity=".05" stroke-width="2"><path d="M372 360 H770"/><path d="M372 400 H770"/><path d="M372 440 H770"/><path d="M372 480 H770"/><path d="M372 520 H770"/><path d="M372 560 H770"/></g>
      <rect x="214" y="438" width="166" height="174" fill="#d2be9f"/>
      <g stroke="#000" stroke-opacity=".05" stroke-width="2"><path d="M214 470 H380"/><path d="M214 510 H380"/><path d="M214 550 H380"/></g>
      <path d="M352 322 L571 182 L606 182 L790 322 Z" fill="url(#h-roofM)"/><path d="M352 322 L571 182 L606 182 L790 322 Z" fill="url(#h-shingle)"/>
      <path d="M790 322 L606 182 L640 172 L912 360 L905 360 Z" fill="url(#h-roofS)"/>
      <path d="M198 442 L297 388 L396 442 Z" fill="url(#h-roofM)"/><path d="M198 442 L297 388 L396 442 Z" fill="url(#h-shingle)"/>
      <path d="M571 182 L606 182" stroke="#5a5462" stroke-width="3"/>
      <rect x="346" y="320" width="450" height="9" rx="4" fill="#8a7a64"/><rect x="192" y="440" width="210" height="8" rx="4" fill="#7d6e58"/><rect x="760" y="329" width="7" height="283" fill="#8a7a64"/>
      <rect x="648" y="206" width="44" height="96" fill="#6b554d"/><rect x="642" y="200" width="56" height="14" rx="2" fill="#7a6258"/><g stroke="#000" stroke-opacity=".12" stroke-width="1.5"><path d="M648 240 H692"/><path d="M648 272 H692"/></g>
      <g class="h-winA"><rect x="406" y="370" width="92" height="108" rx="3" fill="url(#h-win)"/><rect x="414" y="378" width="76" height="92" fill="#fff4d2" opacity=".5"/><rect x="406" y="370" width="92" height="108" rx="3" fill="none" stroke="#6b5b44" stroke-width="6"/><line x1="452" y1="370" x2="452" y2="478" stroke="#6b5b44" stroke-width="4"/><line x1="406" y1="424" x2="498" y2="424" stroke="#6b5b44" stroke-width="4"/><rect x="400" y="478" width="104" height="7" rx="2" fill="#b3a081"/></g>
      <g class="h-winB"><rect x="600" y="370" width="92" height="108" rx="3" fill="url(#h-win)"/><rect x="608" y="378" width="76" height="92" fill="#fff4d2" opacity=".5"/><rect x="600" y="370" width="92" height="108" rx="3" fill="none" stroke="#6b5b44" stroke-width="6"/><line x1="646" y1="370" x2="646" y2="478" stroke="#6b5b44" stroke-width="4"/><line x1="600" y1="424" x2="692" y2="424" stroke="#6b5b44" stroke-width="4"/><rect x="594" y="478" width="104" height="7" rx="2" fill="#b3a081"/></g>
      <circle cx="556" cy="500" r="26" fill="url(#h-porch)"/><rect x="520" y="490" width="76" height="122" rx="4" fill="#4a3a30"/><rect x="520" y="490" width="76" height="122" rx="4" fill="none" stroke="#372a22" stroke-width="3"/><rect x="532" y="506" width="22" height="44" rx="2" fill="#5c4a3c"/><rect x="562" y="506" width="22" height="44" rx="2" fill="#5c4a3c"/><circle cx="585" cy="556" r="3.5" fill="#e7c06a"/>
      <rect x="504" y="486" width="12" height="18" rx="2" fill="#3a2d24"/><circle class="h-porchlight" cx="510" cy="500" r="9" fill="#ffe6a8" filter="url(#h-soft2)"/><circle cx="510" cy="500" r="3.5" fill="#fffbe6"/>
      <rect x="236" y="476" width="122" height="136" rx="3" fill="#bca884"/><rect x="236" y="476" width="122" height="136" rx="3" fill="none" stroke="#a08c68" stroke-width="3"/><g stroke="#9a8763" stroke-width="2"><line x1="236" y1="510" x2="358" y2="510"/><line x1="236" y1="544" x2="358" y2="544"/><line x1="236" y1="578" x2="358" y2="578"/><line x1="277" y1="476" x2="277" y2="612"/><line x1="317" y1="476" x2="317" y2="612"/></g>
      <g><path d="M1010 612 Q1004 540 1012 470" stroke="#2a2018" stroke-width="14" fill="none"/><ellipse cx="1012" cy="430" rx="78" ry="70" fill="#1f3026"/><ellipse cx="960" cy="460" rx="56" ry="50" fill="#24382b"/><ellipse cx="1060" cy="458" rx="54" ry="48" fill="#1b2a21"/><ellipse cx="1012" cy="400" rx="56" ry="48" fill="#28402f"/></g>
      <ellipse cx="150" cy="600" rx="80" ry="40" fill="#1d2c22"/><ellipse cx="200" cy="606" rx="60" ry="32" fill="#243a2c"/>
      <path d="M540 612 L576 612 L640 720 L470 720 Z" fill="#caa86a" opacity=".22"/>
      <g fill="#3c4c40" opacity=".55"><rect x="60" y="624" width="6" height="34"/><rect x="84" y="624" width="6" height="34"/><rect x="108" y="624" width="6" height="34"/><rect x="1100" y="624" width="6" height="34"/><rect x="1124" y="624" width="6" height="34"/><rect x="1148" y="624" width="6" height="34"/></g>
    </g>
    <!-- DIM LAYER: fades in to focus a single system on hover -->
    <rect id="house-dim" x="0" y="0" width="1200" height="820" fill="#0a1322" opacity="0"/>
    <!-- SYSTEM HIGHLIGHT LAYER: populated at runtime, illuminates the hovered system -->
    <g id="house-systems"></g>
    <!-- ATMOSPHERE: ambient particles + chimney smoke -->
    <g class="h-particles" fill="#ffd98a" opacity=".5"><circle cx="430" cy="540" r="2"/><circle cx="660" cy="560" r="1.6"/><circle cx="540" cy="600" r="1.8"/><circle cx="350" cy="580" r="1.4"/><circle cx="720" cy="520" r="1.5"/></g>
    <g class="h-smoke" fill="#c9d0db" opacity=".3" filter="url(#h-soft)"><circle cx="672" cy="180" r="13"/><circle cx="680" cy="148" r="17"/><circle cx="668" cy="112" r="21"/><circle cx="678" cy="78" r="24"/></g>
  </svg>
      </div>

      <!-- interactive hotspots -->
      <div class="hotspots">
        {hotspots.map((h) => (
          <a class="hotspot" data-sys={h.key} href={`/ask?topic=${encodeURIComponent(h.label)}`}
             style={`left:${h.x}%;top:${h.y}%`} aria-label={`Ask Rocco about ${h.label}`}>
            <span class="hotspot-dot" aria-hidden="true"></span>
            <span class="hotspot-label">{h.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== JOURNEY (a moment) ===================== -->
  <section class="journey" aria-labelledby="journey-title">
    <div class="journey-head reveal">
      <p class="eyebrow">How it feels</p>
      <h2 id="journey-title" class="journey-title">From &ldquo;what is that noise?&rdquo;<br />to a pro you trust.</h2>
    </div>
    <div class="journey-track">
      <div class="jstep reveal">
        <span class="jstep-num">01</span>
        <h3>You notice something</h3>
        <p>A stain, a sound, a smell. You don&rsquo;t need the right words &mdash; just describe it.</p>
      </div>
      <span class="journey-arrow" aria-hidden="true">
        <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M0 8h40M34 2l8 6-8 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <div class="jstep reveal">
        <span class="jstep-num">02</span>
        <h3>Rocco helps you understand</h3>
        <p>What it likely is, what it tends to cost, and the right questions to ask. No pressure, no upsell.</p>
      </div>
      <span class="journey-arrow" aria-hidden="true">
        <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M0 8h40M34 2l8 6-8 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <div class="jstep reveal">
        <span class="jstep-num">03</span>
        <h3>You meet a trusted local pro</h3>
        <p>When you&rsquo;re ready, Rocco connects you with a vetted professional near you &mdash; on your terms.</p>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services2" aria-labelledby="services2-title">
    <div class="services2-head reveal">
      <p class="eyebrow">Where Rocco helps</p>
      <h2 id="services2-title" class="services2-title">Starting with the things that go wrong most.</h2>
    </div>
    <div class="services2-grid">
      {services.map((s) => (
        <a class="scard reveal" href={`/services/${s.slug}`}>
          <span class="scard-glow" aria-hidden="true"></span>
          <span class="scard-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 13l5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3 class="scard-title" set:html={s.label}></h3>
          <p class="scard-hint">{s.hint}</p>
          <span class="scard-go">Ask Rocco &rarr;</span>
        </a>
      ))}
    </div>
    <p class="services2-all reveal"><a href="/services">See everything Rocco can help with &rarr;</a></p>
  </section>

  <!-- ===================== ROCCO BAND ===================== -->
  <section class="roccoband" aria-labelledby="roccoband-title">
    <div class="roccoband-inner reveal">
      <div class="roccoband-portrait" aria-hidden="true">
        <img src="/assets/rocco/rocco-headshot.png" alt="" width="200" height="200" />
        <span class="roccoband-ring"></span>
      </div>
      <div class="roccoband-copy">
        <p class="eyebrow eyebrow-light">Meet Rocco</p>
        <h2 id="roccoband-title">He works for you &mdash; not the contractor.</h2>
        <p>Rocco doesn&rsquo;t sell you anything. He helps you understand your home, so you walk into every repair informed, calm, and in control.</p>
        <a class="btn-light" href="/ask">Start a conversation</a>
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING ===================== -->
  <section class="closing2 reveal" aria-labelledby="closing2-title">
    <h2 id="closing2-title" class="closing2-title">Your home has a guide now.</h2>
    <a class="btn-primary btn-xl" href="/ask">Ask Rocco a question</a>
    <p class="closing2-area">Serving the Jersey Shore launch area &mdash; Stafford, Manahawkin, Barnegat, LBI, Toms River, Forked River, Waretown and more. If we can&rsquo;t help in your town yet, Rocco will tell you straight.</p>
  </section>

</BaseLayout>

<style>
  /* ============ shared rhythm ============ */
  .eyebrow{font-size:.82rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--emg-orange,#E8762B);margin:0 0 .9rem}
  .eyebrow-light{color:#F4A24B}
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
  .reveal.in{opacity:1;transform:none}
  :focus-visible{outline:3px solid #F4A24B;outline-offset:3px;border-radius:6px}

  /* ============ HERO ============ */
  .hero2{position:relative;overflow:hidden;text-align:center;padding:clamp(5rem,11vw,9rem) 1.4rem clamp(3.5rem,7vw,6rem);background:linear-gradient(180deg,#FBF8F2 0%,#F6F1E8 100%)}
  .hero2-aurora{position:absolute;inset:-30% -10% auto -10%;height:80%;background:
    radial-gradient(40% 60% at 25% 30%,rgba(244,162,75,.30),transparent 70%),
    radial-gradient(45% 55% at 78% 20%,rgba(34,64,95,.18),transparent 70%),
    radial-gradient(40% 50% at 60% 65%,rgba(58,160,160,.16),transparent 70%);
    filter:blur(20px);animation:auroraDrift 22s ease-in-out infinite alternate}
  @keyframes auroraDrift{0%{transform:translate3d(0,0,0) scale(1)}100%{transform:translate3d(2.5%,2%,0) scale(1.08)}}
  .hero2-grain{position:absolute;inset:0;opacity:.5;pointer-events:none;mix-blend-mode:soft-light;background-image:radial-gradient(rgba(0,0,0,.18) .5px,transparent .5px);background-size:3px 3px}
  .hero2-inner{position:relative;max-width:980px;margin:0 auto}
  .hero2-eyebrow{font-size:.84rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--emg-orange,#E8762B);margin:0 0 1.2rem}
  .hero2-title{font-size:clamp(2.8rem,7vw,5.6rem);line-height:1.02;letter-spacing:-.025em;font-weight:800;color:#16304C;margin:0 0 1.4rem}
  .hero2-title-accent{color:var(--emg-orange,#E8762B)}
  .hero2-lede{font-size:clamp(1.1rem,2.2vw,1.45rem);line-height:1.55;color:#42546A;max-width:720px;margin:0 auto 2.6rem}

  /* ask bar with living Rocco */
